#!/bin/sh
# The one entry point. `.mcp.json`, a consuming site's prebuild hook, the publish
# workflow and a person at a terminal all arrive here.
#
# Three differences from `hex-terraform/mcp/start.sh`, each of which is a failure that
# has happened there or is one step away from happening.
#
#   * The probe is `[ -x node_modules/.bin/tsx ]`, not `[ -d node_modules ]`. A
#     half-finished install leaves the directory present and the binary absent, and a
#     directory probe then trusts it forever and execs something that is not there.
#   * `exec node_modules/.bin/tsx`, not `npx tsx`. npx re-resolves on every run and
#     reaches the network when the local copy is missing, which turns a broken install
#     into a silent download instead of an error.
#   * Not one byte of install output reaches stdout. The same launcher serves
#     `hexdocs mcp`, where stdout is the JSON-RPC stream, and one progress line on
#     stdout is a parse error the client reports as a broken server with no cause.
#
# It deliberately does not cd into the kit. $PWD is the consuming project and is what
# HEXDOCS_PROJECT_ROOT has to capture.
set -eu

KIT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
export HEXDOCS_PROJECT_ROOT="${HEXDOCS_PROJECT_ROOT:-$PWD}"

# The first-run install, silent when it works and complete when it does not.
#
# Its output goes to a file and is replayed to stderr only on failure. On success stderr
# stays empty, and that is load bearing in a consumer: the deploy's build step rejects with
# the last twenty lines of stderr, falling back to stdout only when stderr is empty, and the
# CLI's rows are on stdout. A first build after a submodule bump that printed pnpm's
# progress lines, even a one-line announcement from this script, would push the row that
# says why the build failed out of the only message anybody reads. `--silent` is not the
# answer either: it hides the reason an install failed, which is the one time the output
# matters.
#
# stdin is closed for the install, so it can never read a JSON-RPC frame meant for the
# server this script is about to exec.
install_toolchain() {
	install_log=$(mktemp "${TMPDIR:-/tmp}/hexdocs-install.XXXXXX")
	if (cd "$KIT_DIR" && "$@") </dev/null >"$install_log" 2>&1; then
		rm -f "$install_log"
		return 0
	fi
	echo "hexdocs: installing the toolchain dependencies in $KIT_DIR failed. The installer said:" >&2
	cat "$install_log" >&2
	rm -f "$install_log"
	exit 1
}

if [ ! -x "$KIT_DIR/node_modules/.bin/tsx" ]; then
	if command -v pnpm >/dev/null 2>&1; then
		# --ignore-workspace, because a consuming site is usually a pnpm workspace and the
		# kit sits inside it. Without the flag pnpm walks up to the workspace root and
		# installs that instead: measured by `scripts/check-cli.mjs`'s first-run row, which
		# then finds node_modules at the workspace root and no tsx in the kit, so the exec
		# below fails. The kit has its own lockfile, and this is the flag that makes pnpm
		# read it.
		#
		# --prod is what keeps this cheap in an app repository: tsx and zod are dependencies
		# and everything else is not, so the MCP SDK used to prove the protocol in the test
		# suite never reaches a consumer. esbuild's install script is listed as ignored in
		# kit/package.json, because tsx runs without it (measured) and pnpm otherwise prints
		# a warning box about it on every first run.
		install_toolchain pnpm install --ignore-workspace --frozen-lockfile --prod
	elif command -v npm >/dev/null 2>&1; then
		# npm ignores pnpm-lock.yaml and writes a package-lock.json beside it, so the
		# resolution is fresh rather than pinned. It is the fallback rather than the path
		# because an app repository may be a Swift project with npm and no pnpm.
		install_toolchain npm install --omit=dev --no-audit --no-fund
	else
		echo "hexdocs: neither pnpm nor npm is on PATH, so the toolchain cannot install." >&2
		echo "hexdocs: install one, or run 'pnpm install --prod' in $KIT_DIR yourself." >&2
		exit 1
	fi
fi

exec "$KIT_DIR/node_modules/.bin/tsx" "$KIT_DIR/src/cli/main.ts" "$@"
