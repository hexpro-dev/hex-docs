					"value": "Para onde ir agora"
				}
			],
			"aliases": [
				"where-to-go-next"
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Comece por "
				},
				{
					"type": "link",
					"kind": "internal",
					"slug": "guide/first-tag",
					"children": [
						{
							"type": "text",
							"value": "Leia sua primeira etiqueta"
						}
					]
				},
				{
					"type": "text",
					"value": ", que cobre uma leitura e uma grava\u00e7\u00e3o em um NTAG215 vazio. Se uma etiqueta n\u00e3o for lida de jeito nenhum, revise antes "
				},
				{
					"type": "link",
					"kind": "anchor",
					"anchor": "what-you-need",
					"children": [
						{
							"type": "text",
							"value": "o que voc\u00ea precisa"
						}
					]
				},
				{
					"type": "text",
					"value": ". A maioria das falhas \u00e9 um chip que o leitor n\u00e3o consegue endere\u00e7ar, e n\u00e3o um defeito na etiqueta."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Os n\u00fameros de build e as notas de vers\u00e3o ficam no "
				},
