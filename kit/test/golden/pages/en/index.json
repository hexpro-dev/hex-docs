					"value": "Where to go next"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Start with "
				},
				{
					"type": "link",
					"kind": "internal",
					"slug": "guide/first-tag",
					"children": [
						{
							"type": "text",
							"value": "Scan your first tag"
						}
					]
				},
				{
					"type": "text",
					"value": ", which covers one read and one write on a blank NTAG215. If a tag will not read at all, re-check "
				},
				{
					"type": "link",
					"kind": "anchor",
					"anchor": "what-you-need",
					"children": [
						{
							"type": "text",
							"value": "what you need"
						}
					]
				},
				{
					"type": "text",
					"value": " first. Most failures are a chip the reader cannot address rather than a fault in the tag."
				}
			]
		},
