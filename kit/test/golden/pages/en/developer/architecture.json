		}
	],
	"body": [
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Fixture App is one Xcode project plus five local Swift packages under "
				},
				{
					"type": "inlineCode",
					"value": "Packages/"
				},
				{
					"type": "text",
					"value": ". The app target, "
				},
				{
					"type": "inlineCode",
					"value": "AppShell"
				},
				{
					"type": "text",
					"value": ", is thin. It owns the window and the deep link handler, and every screen it presents comes out of a package."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Dependencies point one way. No package imports the app target, and nothing below "
				},
				{
					"type": "inlineCode",
					"value": "Design"
				},
				{
					"type": "text",
					"value": " knows that a view exists."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"id": "module-graph",
			"idSource": "explicit",
			"children": [
				{
					"type": "text",
					"value": "Module graph"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Read the tree as \"depends on\". AppShell -> Design -> Shaders means the app links "
				},
				{
					"type": "inlineCode",
					"value": "Design"
				},
				{
					"type": "text",
					"value": ", and "
				},
				{
					"type": "inlineCode",
					"value": "Design"
				},
				{
					"type": "text",
					"value": " links "
				},
				{
					"type": "inlineCode",
					"value": "Shaders"
				},
				{
					"type": "text",
					"value": "."
				}
			]
		},
		{
			"lang": "text",
			"type": "code",
			"highlighted": false,
			"lines": [
				{
					"tokens": [
						{
							"text": "AppShell"
						}
					]
				},
				{
					"tokens": [
						{
							"text": "\u251c\u2500 TagSession \u2500\u252c\u2500 ChipProfiles"
						}
					]
				},
				{
					"tokens": [
						{
							"text": "\u2502              \u2514\u2500 TagCodec"
						}
					]
				},
				{
					"tokens": [
						{
							"text": "\u251c\u2500 Design \u2500\u2500\u2500\u2500\u2500\u2500\u2500 Shaders"
						}
					]
				},
				{
					"tokens": [
						{
							"text": "\u2514\u2500 Storage \u2500\u2500\u2500\u2500\u252c\u2500 KeychainVault"
						}
					]
				},
				{
					"tokens": [
						{
							"text": "               \u2514\u2500 ScanLog"
						}
					]
				}
			],
			"showLineNumbers": false
		},
		{
			"type": "list",
			"style": "bullet",
			"tight": true,
			"children": [
				{
					"type": "listItem",
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "TagSession"
								},
								{
									"type": "text",
									"value": " is the only package that imports CoreNFC. It opens the reader session, hands raw NDEF payloads to "
								},
								{
									"type": "inlineCode",
									"value": "TagCodec"
								},
								{
									"type": "text",
									"value": ", and publishes the state machine the Scan sheet observes."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "TagCodec"
								},
								{
									"type": "text",
									"value": " turns NDEF records into "
								},
								{
									"type": "inlineCode",
									"value": "TagRecord"
								},
								{
									"type": "text",
									"value": " values and back. It needs nothing from Apple beyond Foundation, so the "
								},
								{
									"type": "inlineCode",
									"value": "fixturectl"
								},
								{
									"type": "text",
									"value": " command line tool links it directly."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "ChipProfiles"
								},
								{
									"type": "text",
									"value": " holds the per-chip capability table: memory size, password support, lock byte layout and default capacity container. The published version of that table is the "
								},
								{
									"type": "link",
									"kind": "internal",
									"slug": "reference/chip-support",
									"children": [
										{
											"type": "text",
											"value": "chip support matrix"
										}
									]
								},
								{
									"type": "text",
									"value": "."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "Design"
								},
								{
									"type": "text",
									"value": " holds the colour tokens and the two custom views the Scan sheet uses."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "Shaders"
								},
								{
									"type": "text",
									"value": " is a Metal package with one fragment shader in it, the halo that pulses while a session is open."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "inlineCode",
									"value": "Storage"
								},
								{
									"type": "text",
									"value": " appends scan history to a SQLite file and keeps tag passwords in the keychain behind "
								},
								{
									"type": "inlineCode",
									"value": "KeychainVault"
								},
								{
									"type": "text",
									"value": "."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"id": "where-a-scan-happens",
			"idSource": "slug",
			"children": [
				{
					"type": "text",
					"value": "Where a scan happens"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Tapping Scan on the home screen calls "
				},
				{
					"type": "inlineCode",
					"value": "begin(_:)"
				},
				{
					"type": "text",
					"value": " with a "
				},
				{
					"type": "inlineCode",
					"value": "ScanIntent"
				},
				{
					"type": "text",
					"value": ". That call is the boundary. Above it there are views. Below it there is CoreNFC and nothing else."
				}
			]
		},
