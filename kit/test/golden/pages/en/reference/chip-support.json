					{
						"type": "tableCell",
						"children": [
							{
								"type": "status",
								"value": "yes"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "Verified on hardware. Fixture App reads and writes every record type the chip supports, including locked NDEF pages."
							}
						]
					}
				],
				[
					{
						"type": "tableCell",
						"children": [
							{
								"type": "status",
								"value": "partial"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "Partial. Reading works, writing does not, usually because the chip ships with a vendor password Fixture App cannot set."
							}
						]
					}
				],
				[
					{
						"type": "tableCell",
						"children": [
							{
								"type": "status",
								"value": "no"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "Not supported. The chip is recognised during discovery, and the session ends before any write, so the tag is left untouched."
							}
						]
					}
				],
				[
					{
						"type": "tableCell",
						"children": [
							{
								"type": "status",
								"value": "na"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "Not applicable. This chip has no NDEF surface for Fixture App to use."
							}
						]
					}
				]
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Status is recorded per chip revision, so check the revision printed in the row rather than the family name on the packaging."
				}
			]
		},
