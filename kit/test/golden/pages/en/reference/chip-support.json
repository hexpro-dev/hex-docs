	"title": "Chip support matrix",
	"description": "Which NFC chips Fixture App can read and write on iOS, and the caveats that apply to each one.",
	"navTitle": "Chip support",
	"audience": "both",
	"pageKind": "article",
	"tags": [
		"chips"
	],
