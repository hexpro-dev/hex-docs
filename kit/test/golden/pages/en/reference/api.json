						{
							"type": "text",
							"value": "Thrown when"
						}
					]
				},
				{
					"type": "tableCell",
					"children": [
						{
							"type": "text",
							"value": "Message shown"
						}
					]
				}
			],
			"rows": [
				[
					{
						"type": "tableCell",
						"children": [
							{
								"type": "inlineCode",
								"value": "readerUnavailable"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "The device has no NFC reader, or the entitlement is missing"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "\"This iPhone cannot read NFC tags.\""
							}
						]
					}
				],
				[
					{
						"type": "tableCell",
						"children": [
							{
								"type": "inlineCode",
								"value": "sessionSpent"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "inlineCode",
								"value": "begin(_:)"
							},
							{
								"type": "text",
								"value": " called on a finished session"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "(internal, never shown)"
							}
						]
					}
				],
				[
					{
						"type": "tableCell",
						"children": [
							{
								"type": "inlineCode",
								"value": "tagUnsupported"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "The chip answered but is not in the support matrix"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "\"Fixture App does not recognise this tag yet.\""
							}
						]
					}
				],
				[
					{
						"type": "tableCell",
						"children": [
							{
								"type": "inlineCode",
								"value": "payloadTooLarge"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "The record exceeds the tag's user memory"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "\"This tag holds 137 bytes and the record needs 208.\""
							}
						]
					}
				],
				[
					{
						"type": "tableCell",
						"children": [
							{
								"type": "inlineCode",
								"value": "writeRejected"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "The tag is locked or password protected"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "\"This tag is locked and cannot be changed.\""
							}
						]
					}
				],
				[
					{
						"type": "tableCell",
						"children": [
							{
								"type": "inlineCode",
								"value": "lostConnection"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "The tag moved out of range mid-operation"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "\"Hold the tag still and try again.\""
							}
						]
					}
				]
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "inlineCode",
					"value": "lostConnection"
				},
				{
					"type": "text",
					"value": " is the only case the app retries on its own, once, and only for reads. A half-finished write is left alone so that the tag is never rewritten without the user asking."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"id": "the-payload",
			"idSource": "slug",
			"children": [
				{
					"type": "text",
					"value": "The payload"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Fixture App writes a single NDEF record with a MIME type of "
				},
				{
					"type": "inlineCode",
					"value": "application/vnd.hexpro.fixture+json"
				},
