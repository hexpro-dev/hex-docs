				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Build with the "
				},
				{
					"type": "inlineCode",
					"value": "FIXTURE_TAG_LOG"
				},
				{
					"type": "text",
					"value": " environment variable set to "
				},
				{
					"type": "inlineCode",
					"value": "1"
				},
				{
					"type": "text",
					"value": " and the session prints one line per transition to the Xcode console. The format is stable enough to grep and is not localised."
				}
			]
		},
		{
			"type": "code",
			"highlighted": false,
			"lines": [
				{
					"tokens": [
						{
							"text": "TagSession begin intent=writeRoute polling=iso14443,iso15693"
						}
					]
				},
				{
					"tokens": [
						{
							"text": "TagSession connect uid=04A23B9C5D6E80 chip=NTAG215 memory=504"
						}
					]
				},
				{
					"tokens": [
						{
							"text": "TagSession finish bytes=137 duration=0.68s"
						}
					]
				}
			],
			"showLineNumbers": false
		},
		{
			"type": "heading",
			"depth": 2,
			"id": "driving-the-scan-ring",
			"idSource": "slug",
			"children": [
				{
					"type": "text",
					"value": "Driving the scan ring"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "The session publishes a "
				},
				{
					"type": "inlineCode",
					"value": "phase"
				},
				{
					"type": "text",
					"value": " value between 0 and 1 while it polls. The Scan sheet feeds that straight into a fragment shader, so the ring on screen is driven by the radio state rather than by a timer that happens to look right."
				}
			]
		},
		{
			"lang": "metal",
			"langLabel": "Metal",
			"type": "code",
			"highlighted": false,
			"lines": [
				{
					"tokens": [
						{
							"text": "fragment half4 scanPulse(RingVertex in [[stage_in]],"
						}
					]
				},
				{
					"tokens": [
						{
							"text": "                         constant float &phase [[buffer(0)]]) {"
						}
					]
				},
				{
					"tokens": [
						{
							"text": "    float edge = smoothstep(0.46, 0.50, length(in.uv - 0.5));"
						}
					]
				},
				{
					"tokens": [
						{
							"text": "    half3 colour = half3(0.043, 0.463, 0.851);"
						}
					]
				},
				{
					"tokens": [
						{
							"text": "    return half4(colour, half(edge * phase));"
						}
					]
				},
				{
					"tokens": [
						{
							"text": "}"
						}
					]
				}
			],
			"showLineNumbers": false,
			"wrap": true
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Keep the shader free of branches on "
				},
				{
					"type": "inlineCode",
					"value": "phase"
				},
				{
					"type": "text",
					"value": ". The ring is redrawn at 120 Hz on ProMotion devices while the radio is active, and the frame budget is the reason the animation is not a SwiftUI keyframe."
				}
			]
		}
