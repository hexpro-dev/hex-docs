	"body": [
		{
			"type": "paragraph",
			"children": [
				{
					"type": "inlineCode",
					"value": "TagSession"
				},
				{
					"type": "text",
					"value": " wraps Core NFC and is the only type in Fixture App that holds an "
				},
				{
					"type": "inlineCode",
					"value": "NFCTagReaderSession"
				},
				{
					"type": "text",
					"value": ". The Scan sheet, the home screen widget and the share extension all go through it. Reading this page is enough to add a new tag operation without touching Core NFC directly."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "If you have not run a scan on a device yet, start with "
				},
				{
					"type": "link",
					"kind": "internal",
					"slug": "guide/first-tag",
					"children": [
						{
							"type": "text",
							"value": "Scan your first tag"
						}
					]
				},
				{
					"type": "text",
					"value": ". The API below assumes you know what the system sheet looks like."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"id": "starting-a-session",
			"idSource": "slug",
			"children": [
				{
					"type": "text",
					"value": "Starting a session"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "inlineCode",
					"value": "begin(_:)"
				},
				{
					"type": "text",
					"value": " takes an "
				},
				{
					"type": "inlineCode",
					"value": "Intent"
				},
				{
					"type": "text",
					"value": ", which names the operation and carries the prompt string iOS shows in the sheet. It throws before any hardware is touched when the device cannot read tags, so a simulator build fails at the call site instead of waiting on a sheet that never appears."
				}
			]
		},
