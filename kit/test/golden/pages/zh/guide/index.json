								{
									"type": "text",
									"value": "\u5217\u51fa\u4e86NFC\u5c04\u9891\u6a21\u5757\u53ef\u80fd\u8fd4\u56de\u7684\u9519\u8bef\uff0c\u4ee5\u53ca\u6bcf\u79cd\u9519\u8bef\u5728\u5b9e\u9645\u4f7f\u7528\u4e2d\u7684\u542b\u4e49\u3002\u4f1a\u8bdd\u8d85\u65f6\u3001\u53ea\u8bfb\u5f97\u51fa\u4e00\u6b21\u4e4b\u540e\u518d\u4e5f\u8bfb\u4e0d\u5230\u7684\u6807\u7b7e\uff0c\u8fd8\u6709\u5360\u4e86\u5927\u591a\u6570\u53cd\u9988\u7684\u5929\u7ebf\u4f4d\u7f6e\u95ee\u9898\uff0c\u90fd\u5728\u90a3\u4e00\u9875\u91cc\u3002"
