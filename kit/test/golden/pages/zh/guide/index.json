			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u8fd9\u4e24\u9875\u90fd\u5047\u8bbe\u4f60\u5728\u9996\u6b21\u542f\u52a8\u65f6\u540c\u610f\u4e86\u5e94\u7528\u7684NFC\u6388\u6743\u63d0\u793a\u3002\u5982\u679c\u4f60\u62d2\u7edd\u4e86\uff0c\u626b\u63cf\u6309\u94ae\u4f1a\u4e0d\u53ef\u7528\uff0c\u6807\u7b7e\u5c4f\u5e55\u9876\u90e8\u4f1a\u51fa\u73b0\u4e00\u6761\u5199\u7740\u201cNFC\u4e0d\u53ef\u7528\u201d\u7684\u6a2a\u5e45\u3002\u53ea\u6709\u5220\u9664\u5e76\u91cd\u65b0\u5b89\u88c5\u5e94\u7528\uff0c\u624d\u80fd\u518d\u6b21\u770b\u5230\u90a3\u4e2a\u63d0\u793a\u3002"
				}
			]
