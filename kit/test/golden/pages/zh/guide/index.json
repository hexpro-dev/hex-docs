				{
					"type": "text",
					"value": "\u82af\u7247\u5bb9\u91cf\u3001\u5b58\u50a8\u5e03\u5c40\uff0c\u4ee5\u53ca\u6bcf\u6b3e\u82af\u7247\u63a5\u53d7\u7684\u5177\u4f53\u8bb0\u5f55\u7c7b\u578b\uff0c\u90fd\u5728\u53c2\u8003\u7ae0\u8282\u91cc\uff0c\u800c\u4e0d\u5728\u8fd9\u91cc\u3002\u5982\u679c\u4f60\u6b63\u5728\u6311\u9009\u8981\u4e70\u7684\u6807\u7b7e\uff0c\u8bf7\u5148\u770b\u82af\u7247\u652f\u6301\u77e9\u9635\uff0c\u800c\u4e0d\u662f\u672c\u6307\u5357\u3002"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "Fixture App\u7684URL scheme\u3001\u5feb\u6377\u6307\u4ee4\u52a8\u4f5c\u548c\u6807\u7b7e\u4f1a\u8bdd\u56de\u8c03\u5c5e\u4e8e\u5f00\u53d1\u8005\u5185\u5bb9\u3002\u6307\u5357\u91cc\u4e0d\u4f1a\u91cd\u590d\u5b83\u4eec\uff0c\u56e0\u4e3a\u6307\u5357\u662f\u5199\u7ed9\u624b\u91cc\u62ff\u7740\u4e00\u90e8\u624b\u673a\u548c\u4e00\u5f20\u8d34\u7eb8\u7684\u4eba\u770b\u7684\u3002"
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "\u5199\u5165\u5931\u8d25\u7684\u6807\u7b7e\u901a\u5e38\u5e76\u6ca1\u6709\u574f\u3002\u5199\u5165\u64cd\u4f5c\u8981\u6c42\u6807\u7b7e\u5728\u6574\u4e2a\u8fc7\u7a0b\u4e2d\u90fd\u7559\u5728\u5c04\u9891\u573a\u91cc\uff0c\u8bfb\u53d6\u63d0\u793a\u97f3\u4e4b\u540e\u624b\u4e00\u79fb\u5f00\uff0c\u5199\u5165\u5c31\u4f1a\u4e2d\u6b62\uff0c\u6807\u7b7e\u4ecd\u7136\u53ef\u8bfb\uff0c\u5185\u5bb9\u4e5f\u6ca1\u6709\u53d8\u5316\u3002\u8bf7\u4fdd\u6301\u4e0d\u52a8\uff0c\u76f4\u5230\u7b2c\u4e8c\u58f0\u63d0\u793a\u97f3\u54cd\u8d77\u3002"
						}
					]
				}
			]
		},
