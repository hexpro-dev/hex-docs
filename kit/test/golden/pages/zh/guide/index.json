			"children": [
				{
					"type": "text",
					"value": "\u5982\u679c\u4f60\u8981\u914d\u7f6e\u7684\u6807\u7b7e\u4e0d\u6b62\u51e0\u679a\uff0c\u5148\u5728\u4e00\u679a\u4e0a\u628a\u6574\u4e2a\u6d41\u7a0b\u8d70\u5b8c\uff0c\u518d\u53bb\u52a8\u5176\u4f59\u7684\u3002\u5199\u5165\uff0c\u7528\u7b2c\u4e8c\u90e8\u624b\u673a\u8bfb\u56de\u6765\uff0c\u7136\u540e\u9501\u5b9a\u3002\u5df2\u9501\u5b9a\u7684NTAG213\u65e0\u6cd5\u91cd\u5199\uff0c\u6240\u4ee5\u5728\u7b2c\u4e00\u679a\u6807\u7b7e\u4e0a\u53d1\u73b0\u7684\u9519\u8bef\u53ea\u635f\u5931\u4e00\u5f20\u8d34\u7eb8\uff0c\u5728\u7b2c\u4e24\u767e\u679a\u4e0a\u624d\u53d1\u73b0\u7684\u9519\u8bef\u8981\u642d\u8fdb\u4e00\u4e2a\u4e0b\u5348\u3002"
