					]
				},
				{
					"type": "text",
					"value": " \u0643\u0644 \u0639\u0627\u0626\u0644\u0629 \u0628\u0637\u0627\u0642\u0627\u062a \u064a\u062a\u0639\u0631\u0651\u0641 \u0639\u0644\u064a\u0647\u0627 \u200fFixture App\u200f\u060c \u0645\u0639 \u0627\u0644\u0630\u0627\u0643\u0631\u0629 \u0627\u0644\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u060c \u0648\u0623\u0648\u0636\u0627\u0639 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u062a\u064a \u062a\u0642\u0628\u0644\u0647\u0627 \u0643\u0644 \u0648\u0627\u062d\u062f\u0629\u060c \u0648\u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0628\u062a\u0627\u062a \u0642\u0641\u0644\u0647\u0627 \u0623\u062d\u0627\u062f\u064a\u0629 \u0627\u0644\u0627\u062a\u062c\u0627\u0647. \u0631\u0627\u062c\u0639\u0647 \u0642\u0628\u0644 \u0623\u0646 \u062a\u0634\u062a\u0631\u064a \u062f\u0641\u0639\u0629 \u0645\u0646 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a."
				}
			]
		},
