							{
								"type": "status",
								"value": "yes"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "\u0645\u064f\u062a\u062d\u0642\u064e\u0651\u0642 \u0645\u0646\u0647 \u0639\u0644\u0649 \u0627\u0644\u0639\u062a\u0627\u062f. \u064a\u0642\u0631\u0623 Fixture App \u0648\u064a\u0643\u062a\u0628 \u0643\u0644 \u0646\u0648\u0639 \u0633\u062c\u0644 \u062a\u062f\u0639\u0645\u0647 \u0627\u0644\u0634\u0631\u064a\u062d\u0629\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0635\u0641\u062d\u0627\u062a NDEF \u0627\u0644\u0645\u0642\u0641\u0644\u0629."
							}
						]
					}
				],
				[
					{
						"type": "tableCell",
						"children": [
							{
								"type": "status",
								"value": "partial"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "\u062c\u0632\u0626\u064a. \u0627\u0644\u0642\u0631\u0627\u0621\u0629 \u062a\u0639\u0645\u0644 \u0648\u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0644\u0627 \u062a\u0639\u0645\u0644\u060c \u0648\u0630\u0644\u0643 \u0639\u0627\u062f\u0629\u064b \u0644\u0623\u0646 \u0627\u0644\u0634\u0631\u064a\u062d\u0629 \u062a\u064f\u0634\u062d\u0646 \u0628\u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631 \u0645\u0646 \u0627\u0644\u0645\u0648\u0631\u0651\u062f \u0644\u0627 \u064a\u0633\u062a\u0637\u064a\u0639 Fixture App \u0636\u0628\u0637\u0647\u0627."
							}
						]
					}
				],
				[
					{
						"type": "tableCell",
						"children": [
							{
								"type": "status",
								"value": "no"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "\u063a\u064a\u0631 \u0645\u062f\u0639\u0648\u0645. \u062a\u064f\u0645\u064a\u064e\u0651\u0632 \u0627\u0644\u0634\u0631\u064a\u062d\u0629 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0627\u0643\u062a\u0634\u0627\u0641\u060c \u0648\u062a\u0646\u062a\u0647\u064a \u0627\u0644\u062c\u0644\u0633\u0629 \u0642\u0628\u0644 \u0623\u064a \u0643\u062a\u0627\u0628\u0629\u060c \u0641\u062a\u0628\u0642\u0649 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u062f\u0648\u0646 \u0645\u0633\u0627\u0633."
							}
						]
					}
				],
				[
					{
						"type": "tableCell",
						"children": [
							{
								"type": "status",
								"value": "na"
							}
						]
					},
					{
						"type": "tableCell",
						"children": [
							{
								"type": "text",
								"value": "\u0644\u0627 \u064a\u0646\u0637\u0628\u0642. \u0644\u0627 \u062a\u0648\u062c\u062f \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0634\u0631\u064a\u062d\u0629 \u0648\u0627\u062c\u0647\u0629 NDEF \u064a\u0633\u062a\u062e\u062f\u0645\u0647\u0627 Fixture App."
							}
						]
					}
				]
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u062a\u064f\u0633\u062c\u064e\u0651\u0644 \u0627\u0644\u062d\u0627\u0644\u0629 \u0644\u0643\u0644 \u0645\u0631\u0627\u062c\u0639\u0629 \u0634\u0631\u064a\u062d\u0629\u060c \u0644\u0630\u0627 \u0631\u0627\u062c\u0639 \u0631\u0642\u0645 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0645\u0637\u0628\u0648\u0639 \u0641\u064a \u0627\u0644\u0635\u0641 \u0628\u062f\u0644\u064b\u0627 \u0645\u0646 \u0627\u0633\u0645 \u0627\u0644\u0639\u0627\u0626\u0644\u0629 \u0639\u0644\u0649 \u0627\u0644\u0639\u0628\u0648\u0629."
				}
			]
		},
