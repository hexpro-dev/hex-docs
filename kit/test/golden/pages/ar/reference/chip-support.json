		"chips"
	],
	"toc": false,
	"headings": [
		{
			"id": "\u0645\u0627-\u0627\u0644\u0630\u064a-\u062a\u0639\u0646\u064a\u0647-\u0627\u0644\u062a\u062d\u0641\u0638\u0627\u062a",
			"depth": 2,
			"text": "\u0645\u0627 \u0627\u0644\u0630\u064a \u062a\u0639\u0646\u064a\u0647 \u0627\u0644\u062a\u062d\u0641\u0638\u0627\u062a"
		},
		{
			"id": "\u0625\u0630\u0627-\u0644\u0645-\u062a\u0643\u0646-\u0627\u0644\u0634\u0631\u064a\u062d\u0629-\u0645\u062f\u0631\u062c\u0629",
			"depth": 2,
			"text": "\u0625\u0630\u0627 \u0644\u0645 \u062a\u0643\u0646 \u0627\u0644\u0634\u0631\u064a\u062d\u0629 \u0645\u062f\u0631\u062c\u0629"
		}
	],
	"body": [
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u064a\u062e\u0627\u0637\u0628 Fixture App \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0639\u0628\u0631 Core NFC\u060c \u0641\u0627\u0644\u0634\u0631\u064a\u062d\u0629 \u0644\u0627 \u062a\u0639\u0645\u0644 \u0625\u0644\u0627 \u0625\u0630\u0627 \u0627\u0633\u062a\u062c\u0627\u0628\u062a \u0628\u0648\u0635\u0641\u0647\u0627 \u0623\u062d\u062f \u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u062a\u064a\u062d\u0647\u0627 iOS: \u0627\u0644\u0646\u0648\u0639 2 \u0641\u0648\u0642 \u200fISO 14443A\u200f\u060c \u0623\u0648 \u0627\u0644\u0646\u0648\u0639 4 \u0641\u0648\u0642 ISO 7816\u200f\u060c \u0623\u0648 \u0627\u0644\u0646\u0648\u0639 5 \u0641\u0648\u0642 ISO 15693\u200f. \u0648\u0627\u0644\u0634\u0631\u064a\u062d\u0629 \u0627\u0644\u062a\u064a \u0644\u0627 \u062a\u0633\u062a\u062c\u064a\u0628 \u0625\u0644\u0627 \u0639\u0644\u0649 \u0628\u0631\u0648\u062a\u0648\u0643\u0648\u0644 \u062e\u0627\u0635 \u062a\u0638\u0647\u0631 \u0643\u0645\u0639\u0631\u0651\u0641 \u0644\u0627 \u0623\u0643\u062b\u0631."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u0643\u0644 \u0646\u062a\u064a\u062c\u0629 \u0623\u062f\u0646\u0627\u0647 \u0645\u0623\u062e\u0648\u0630\u0629 \u0645\u0646 iPhone 13\u200f \u0648\u0645\u0646 iPhone 15 Pro\u200f \u064a\u0639\u0645\u0644\u0627\u0646 \u0628\u0646\u0638\u0627\u0645 \u200fiOS 18.2\u200f\u060c \u0639\u0644\u0649 \u0628\u0637\u0627\u0642\u0627\u062a \u0641\u0627\u0631\u063a\u0629 \u0645\u0646 \u062b\u0644\u0627\u062b\u0629 \u0645\u0648\u0631\u062f\u064a\u0646. \u00ab\u0642\u0631\u0627\u0621\u0629\u00bb \u062a\u0639\u0646\u064a \u0623\u0646 \u0648\u0631\u0642\u0629 \u0627\u0644\u0645\u0633\u062d \u062a\u0633\u062d\u0628 \u0631\u0633\u0627\u0644\u0629 NDEF \u0645\u0646 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u062f\u0648\u0646 \u0625\u0639\u062f\u0627\u062f \u0625\u0636\u0627\u0641\u064a. \u0648\u00ab\u0643\u062a\u0627\u0628\u0629\u00bb \u062a\u0639\u0646\u064a \u0623\u0646 \u0648\u0631\u0642\u0629 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u062a\u0639\u064a\u062f \u0648\u0636\u0639 \u0631\u0633\u0627\u0644\u0629 \u062c\u062f\u064a\u062f\u0629 \u0648\u062a\u0628\u0644\u0651\u063a \u0639\u0646 \u0627\u0644\u0628\u0627\u064a\u062a\u0627\u062a \u0627\u0644\u062d\u0631\u0629 \u0627\u0644\u0645\u062a\u0628\u0642\u064a\u0629 \u0628\u0639\u062f\u0647\u0627. \u0648\u00ab\u0630\u0627\u0643\u0631\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u00bb \u0647\u064a \u0627\u0644\u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u062a\u064a \u064a\u0645\u0643\u0646 \u0623\u0646 \u062a\u0634\u063a\u0644\u0647\u0627 \u0631\u0633\u0627\u0644\u0629 NDEF\u200f\u060c \u0648\u0647\u064a \u062f\u0627\u0626\u0645\u064b\u0627 \u0623\u0642\u0644 \u0645\u0646 \u0627\u0644\u0630\u0627\u0643\u0631\u0629 \u0627\u0644\u0643\u0644\u064a\u0629 \u0639\u0644\u0649 \u0627\u0644\u0631\u0642\u0627\u0642\u0629."
				}
			]
		},
