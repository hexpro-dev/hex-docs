		{
			"type": "heading",
			"depth": 2,
			"id": "\u0645\u0627-\u0627\u0644\u0630\u064a-\u062a\u0639\u0646\u064a\u0647-\u0627\u0644\u062a\u062d\u0641\u0638\u0627\u062a",
			"idSource": "slug",
			"children": [
				{
					"type": "text",
					"value": "\u0645\u0627 \u0627\u0644\u0630\u064a \u062a\u0639\u0646\u064a\u0647 \u0627\u0644\u062a\u062d\u0641\u0638\u0627\u062a"
				}
			],
			"aliases": [
				"what-the-caveats-mean"
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u0648\u062c\u0648\u062f "
				},
				{
					"type": "status",
					"value": "partial"
				},
				{
					"type": "text",
					"value": " \u0641\u064a \u0639\u0645\u0648\u062f \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u064a\u0639\u0646\u064a \u0623\u0646 \u0627\u0644\u0634\u0631\u064a\u062d\u0629 \u0644\u0627 \u062a\u0642\u0628\u0644 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0625\u0644\u0627 \u0628\u0639\u062f \u062e\u0637\u0648\u0629 \u0625\u0636\u0627\u0641\u064a\u0629\u060c \u0644\u0627 \u0623\u0646 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u063a\u064a\u0631 \u0645\u0648\u062b\u0648\u0642\u0629 \u0628\u0639\u062f \u0623\u0646 \u062a\u0628\u062f\u0623."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u062a\u064f\u0634\u062d\u0646 NTAG424 DNA \u0648\u0645\u0644\u0641 NDEF \u0641\u064a\u0647\u0627 \u0645\u0642\u0641\u0644 \u062e\u0644\u0641 \u0645\u0635\u0627\u062f\u0642\u0629 AES\u200f\u060c \u0641\u062a\u0637\u0644\u0628 \u0648\u0631\u0642\u0629 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0645\u0641\u062a\u0627\u062d \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0642\u0628\u0644 \u0623\u0646 \u062a\u063a\u064a\u0651\u0631 \u0623\u064a \u0634\u064a\u0621. \u0648\u062a\u0633\u062a\u062e\u062f\u0645 Ultralight C\u200f \u062a\u0634\u0641\u064a\u0631 3DES \u0639\u0644\u0649 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0641\u0648\u0642 \u0627\u0644\u0639\u062f\u0651\u0627\u062f\u060c \u0648\u064a\u0643\u062a\u0628 Fixture App \u062a\u062d\u062a \u0628\u0627\u064a\u062a \u0627\u0644\u0642\u0641\u0644 \u0645\u0627 \u0644\u0645 \u062a\u0644\u0635\u0642 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0641\u064a \u00ab\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\u060c \u0645\u062a\u0642\u062f\u0645\u060c \u0645\u0641\u0627\u062a\u064a\u062d \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a\u00bb. \u0648\u062a\u0633\u062a\u062c\u064a\u0628 \u200fICODE SLIX2\u200f \u0639\u0644\u0649 ISO 15693\u200f \u0648\u062a\u062e\u0632\u0651\u0646 \u0631\u0633\u0627\u0644\u062a\u0647\u0627 \u0641\u064a \u0643\u062a\u0644 \u0645\u0646 \u0623\u0631\u0628\u0639\u0629 \u0628\u0627\u064a\u062a\u0627\u062a\u060c \u0641\u064a\u0646\u062e\u0641\u0636 \u0631\u0642\u0645 \u0627\u0644\u0628\u0627\u064a\u062a\u0627\u062a \u0627\u0644\u062d\u0631\u0629 \u0628\u062e\u0637\u0648\u0627\u062a \u0645\u0646 \u0623\u0631\u0628\u0639\u0629."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u0634\u0631\u064a\u062d\u0629 DESFire EV3\u200f \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0642\u0631\u0627\u0621\u0629 \u0644\u0627 \u0623\u0643\u062b\u0631. \u064a\u0633\u062a\u0637\u064a\u0639 \u0627\u0644\u0647\u0627\u062a\u0641 \u0627\u062e\u062a\u064a\u0627\u0631 \u062a\u0637\u0628\u064a\u0642 \u200fNDEF \u0648\u0642\u0631\u0627\u0621\u0629 \u0645\u0627 \u0641\u064a\u0647\u060c \u0644\u0643\u0646 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0645\u0644\u0641 \u0623\u0648 \u062a\u063a\u064a\u064a\u0631 \u062d\u062c\u0645\u0647 \u064a\u062d\u062a\u0627\u062c \u0645\u0641\u062a\u0627\u062d\u064b\u0627 \u0644\u0646 \u0646\u0637\u0644\u0628 \u0645\u0646\u0643 \u062d\u0645\u0644\u0647\u060c \u0641\u064a\u0628\u0642\u0649 \u0632\u0631 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0628\u0627\u0647\u062a\u064b\u0627 \u0648\u064a\u0639\u0631\u0636 \u00ab\u0647\u0630\u0647 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0644\u0644\u0642\u0631\u0627\u0621\u0629 \u0641\u0642\u0637 \u0639\u0644\u0649 iPhone\u00bb. \u0623\u0645\u0627 MIFARE Classic 1K \u0641\u063a\u064a\u0631 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0642\u0631\u0627\u0621\u0629 \u0625\u0637\u0644\u0627\u0642\u064b\u0627. \u064a\u0639\u064a\u062f \u200fiOS \u0627\u0644\u0645\u0639\u0631\u0651\u0641 \u0648\u064a\u062a\u0648\u0642\u0641 \u0639\u0646\u062f \u0630\u0644\u0643\u060c \u0648\u062a\u0628\u0644\u0651\u063a \u0648\u0631\u0642\u0629 \u0627\u0644\u0645\u0633\u062d \u0639\u0646 \u0627\u0644\u062e\u0637\u0623 2001\u060c \u00ab\u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u063a\u064a\u0631 \u0645\u062a\u0648\u0627\u0641\u0642\u0629 \u0645\u0639 NDEF\u00bb. \u0648\u0644\u0627 \u062a\u062d\u0645\u0644 \u0623\u064a \u0645\u0646 \u0627\u0644\u0634\u0631\u064a\u062d\u062a\u064a\u0646 \u0631\u0642\u0645\u064b\u0627 \u0641\u064a \u0639\u0645\u0648\u062f \u0627\u0644\u0630\u0627\u0643\u0631\u0629: \u0641\u0641\u064a DESFire \u064a\u064f\u062b\u0628\u064e\u0651\u062a \u0627\u0644\u062d\u062c\u0645 \u0639\u0646\u062f \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0645\u0644\u0641\u060c \u0648\u0641\u064a Classic \u0644\u0627 \u064a\u0648\u062c\u062f \u0645\u0644\u0641 NDEF \u0644\u0642\u064a\u0627\u0633\u0647."
				}
			]
		},
		{
