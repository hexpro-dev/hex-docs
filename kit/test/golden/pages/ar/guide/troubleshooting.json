					"value": "\u0628\u0637\u0627\u0642\u0627\u062a \u062a\u064f\u0642\u0631\u0623 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u062b\u0645 \u062a\u0635\u0645\u062a"
