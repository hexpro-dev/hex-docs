		{
			"id": "\u0644\u0645\u0627\u0630\u0627-\u064a\u0642\u0648\u0644-\u0627\u0644\u062a\u0637\u0628\u064a\u0642-\u0646\u0648\u0639-\u0627\u0644\u0628\u0637\u0627\u0642\u0629-\u063a\u064a\u0631-\u0645\u062f\u0639\u0648\u0645",
			"depth": 2,
			"text": "\u0644\u0645\u0627\u0630\u0627 \u064a\u0642\u0648\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u00ab\u0646\u0648\u0639 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u063a\u064a\u0631 \u0645\u062f\u0639\u0648\u0645\u00bb\u061f"
		},
		{
			"id": "\u0645\u0627\u0630\u0627-\u0623\u0631\u0633\u0644-\u0639\u0646\u062f\u0645\u0627-\u0623\u0628\u0644-\u063a-\u0639\u0646-\u0645\u0634\u0643\u0644\u0629-\u0641\u064a-\u0627\u0644\u0645\u0633\u062d",
			"depth": 2,
			"text": "\u0645\u0627\u0630\u0627 \u0623\u0631\u0633\u0644 \u0639\u0646\u062f\u0645\u0627 \u0623\u0628\u0644\u0651\u063a \u0639\u0646 \u0645\u0634\u0643\u0644\u0629 \u0641\u064a \u0627\u0644\u0645\u0633\u062d\u061f"
		}
	],
	"body": [
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u0645\u0639\u0638\u0645 \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0645\u0633\u062d \u0627\u0644\u0641\u0627\u0634\u0644\u0629 \u062a\u0631\u062c\u0639 \u0625\u0644\u0649 \u0645\u0648\u0636\u0639 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0645\u0646 \u0627\u0644\u0647\u0627\u062a\u0641\u060c \u0623\u0648 \u0625\u0644\u0649 \u0627\u0644\u0634\u0631\u064a\u062d\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0628\u0637\u0627\u0642\u0629. \u0627\u0628\u062d\u062b \u0639\u0646 \u0627\u0644\u0633\u0624\u0627\u0644 \u0627\u0644\u0645\u0637\u0627\u0628\u0642 \u0644\u0645\u0627 \u0631\u0623\u064a\u062a\u0647 \u0639\u0644\u0649 \u0627\u0644\u0634\u0627\u0634\u0629 \u0648\u0627\u0646\u0637\u0644\u0642 \u0645\u0646\u0647."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"id": "\u0644\u0645\u0627\u0630\u0627-\u0644\u0627-\u064a\u062d\u062f\u062b-\u0634\u064a\u0621-\u0639\u0646\u062f\u0645\u0627-\u0623\u0636\u0639-\u0628\u0637\u0627\u0642\u0629-\u0639\u0644\u0649-\u0647\u0627\u062a\u0641\u064a",
			"idSource": "slug",
			"children": [
				{
					"type": "text",
					"value": "\u0644\u0645\u0627\u0630\u0627 \u0644\u0627 \u064a\u062d\u062f\u062b \u0634\u064a\u0621 \u0639\u0646\u062f\u0645\u0627 \u0623\u0636\u0639 \u0628\u0637\u0627\u0642\u0629 \u0639\u0644\u0649 \u0647\u0627\u062a\u0641\u064a\u061f"
				}
			],
			"aliases": [
				"why-does-nothing-happen-when-i-hold-a-tag-to-my-phone"
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u064a\u0642\u0639 \u0647\u0648\u0627\u0626\u064a NFC \u0641\u064a \u0623\u0639\u0644\u0649 \u0627\u0644\u0644\u0648\u062d\u0629 \u0627\u0644\u062e\u0644\u0641\u064a\u0629\u060c \u0628\u062c\u0648\u0627\u0631 \u0634\u0631\u064a\u0637 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627. \u0648\u0625\u0633\u0646\u0627\u062f \u0648\u0633\u0637 \u0627\u0644\u0647\u0627\u062a\u0641 \u0625\u0644\u0649 \u0628\u0637\u0627\u0642\u0629 \u064a\u062a\u0631\u0643 \u0646\u062d\u0648 40 \u0645\u0645 \u0628\u064a\u0646 \u0627\u0644\u0647\u0648\u0627\u0626\u064a \u0648\u0627\u0644\u0634\u0631\u064a\u062d\u0629\u060c \u0648\u0647\u064a \u0645\u0633\u0627\u0641\u0629 \u0643\u0627\u0641\u064a\u0629 \u0644\u062a\u0628\u0642\u0649 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0646\u0627\u0626\u0645\u0629. \u062d\u0631\u0651\u0643 \u0627\u0644\u062d\u0627\u0641\u0629 \u0627\u0644\u0639\u0644\u0648\u064a\u0629 \u0645\u0646 \u0627\u0644\u0647\u0627\u062a\u0641 \u0641\u0648\u0642 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0628\u062f\u0644\u064b\u0627 \u0645\u0646 \u0630\u0644\u0643."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u062a\u0639\u0631\u0636 \u0648\u0631\u0642\u0629 \u0627\u0644\u0645\u0633\u062d \u0634\u0627\u0631\u0629 "
				},
				{
					"type": "image",
					"src": "assets/e58ff68f6c7bd6e46d20ea7549e3b2fd36a18753a219eac80b64b7cb1bce6949.svg",
					"alt": "\u0644\u0627\u062a\u0644\u0627\u0645\u0633\u064a",
					"width": 24,
					"height": 24
				},
				{
					"type": "text",
					"value": " \u0641\u064a \u0631\u0643\u0646\u0647\u0627 \u0627\u0644\u0639\u0644\u0648\u064a \u0627\u0644\u0623\u064a\u0645\u0646 \u0637\u0648\u0627\u0644 \u0645\u062f\u0629 \u0625\u0646\u0635\u0627\u062a \u0627\u0644\u0631\u0627\u062f\u064a\u0648. \u0648\u0625\u0630\u0627 \u0644\u0645 \u062a\u0638\u0647\u0631 \u062a\u0644\u0643 \u0627\u0644\u0634\u0627\u0631\u0629 \u0623\u0628\u062f\u064b\u0627\u060c \u0641\u0627\u0644\u062c\u0644\u0633\u0629 \u0644\u0645 \u062a\u0628\u062f\u0623. \u0623\u063a\u0644\u0642 \u0627\u0644\u0648\u0631\u0642\u0629\u060c \u0648\u0627\u0646\u062a\u0638\u0631 \u0644\u062d\u0638\u0629\u060c \u062b\u0645 \u0627\u0641\u062a\u062d\u0647\u0627 \u0645\u0646 \u062c\u062f\u064a\u062f."
				}
			]
		},
		{
			"type": "heading",
			"depth": 3,
			"id": "\u0627\u0641\u062d\u0635-\u0627\u0644\u0628\u0637\u0627\u0642\u0629-\u0642\u0628\u0644-\u0623\u0646-\u062a\u0644\u0648\u0645-\u0627\u0644\u0647\u0627\u062a\u0641",
			"idSource": "slug",
			"children": [
				{
					"type": "text",
					"value": "\u0627\u0641\u062d\u0635 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0642\u0628\u0644 \u0623\u0646 \u062a\u0644\u0648\u0645 \u0627\u0644\u0647\u0627\u062a\u0641"
				}
			],
			"aliases": [
				"check-the-tag-before-you-blame-the-phone"
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u0642\u062f \u062a\u0643\u0648\u0646 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0645\u0642\u0631\u0648\u0621\u0629 \u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u063a\u064a\u0631 \u0645\u0631\u0626\u064a\u0629 \u0644\u0622\u062e\u0631. \u064a\u0631\u0634\u0651\u062d iOS \u0639\u0627\u0626\u0644\u0627\u062a \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0642\u0628\u0644 \u0623\u0646 \u064a\u0631\u0627\u0647\u0627 \u0623\u064a \u062a\u0637\u0628\u064a\u0642\u060c \u0641\u0627\u0644\u0634\u0631\u064a\u062d\u0629 \u0627\u0644\u062a\u064a \u0644\u0627 \u064a\u0645\u0644\u0643 Fixture App \u0645\u0641\u0643\u0651\u0643 \u062a\u0631\u0645\u064a\u0632 \u0644\u0647\u0627 \u0644\u0627 \u062a\u0635\u0644 \u0625\u0644\u0649 \u0648\u0631\u0642\u0629 \u0627\u0644\u0645\u0633\u062d \u0623\u0628\u062f\u064b\u0627."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u062b\u0644\u0627\u062b \u062d\u0627\u0644\u0627\u062a \u062a\u0641\u0633\u0651\u0631 \u0645\u0639\u0638\u0645 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0635\u0627\u0645\u062a\u0629."
				}
			]
		},
		{
			"type": "list",
			"style": "bullet",
			"tight": true,
			"children": [
				{
					"type": "listItem",
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "\u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0645\u0644\u0635\u0648\u0642\u0629 \u0639\u0644\u0649 \u0645\u0639\u062f\u0646. \u0627\u0644\u0645\u0644\u0635\u0642 \u0639\u0644\u0649 \u063a\u0637\u0627\u0621 \u062d\u0627\u0633\u0648\u0628 \u0645\u062d\u0645\u0648\u0644 \u0623\u0648 \u0639\u0644\u0649 \u0639\u0644\u0628\u0629 \u0628\u0633\u0643\u0648\u064a\u062a \u064a\u0632\u064a\u062d \u0636\u0628\u0637 \u0627\u0644\u0647\u0648\u0627\u0626\u064a \u0628\u0645\u0627 \u064a\u0643\u0641\u064a \u0644\u0623\u0644\u0627 \u064a\u0633\u062a\u062c\u064a\u0628 \u0634\u064a\u0621."
								}
							]
						},
						{
							"type": "list",
							"style": "bullet",
							"tight": true,
							"children": [
								{
									"type": "listItem",
									"children": [
										{
											"type": "paragraph",
											"children": [
												{
													"type": "text",
													"value": "\u0637\u0628\u0642\u0629 \u0641\u0631\u0651\u064a\u062a \u0628\u064a\u0646 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0648\u0627\u0644\u0645\u0639\u062f\u0646 \u062a\u0639\u064a\u062f \u0627\u0644\u0645\u062f\u0649."
												}
											]
										}
									]
								},
								{
									"type": "listItem",
									"children": [
										{
											"type": "paragraph",
											"children": [
												{
													"type": "text",
													"value": "\u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u064f\u0628\u0627\u0639 \u0639\u0644\u0649 \u0623\u0646\u0647\u0627 \u0635\u0627\u0644\u062d\u0629 \u0644\u0644\u0645\u0639\u062f\u0646 \u062a\u062d\u062a\u0648\u064a \u062a\u0644\u0643 \u0627\u0644\u0637\u0628\u0642\u0629 \u0623\u0635\u0644\u064b\u0627."
												}
											]
										}
									]
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "\u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u062a\u0633\u062a\u062e\u062f\u0645 \u0634\u0631\u064a\u062d\u0629 \u0644\u0627 \u064a\u062a\u064a\u062d\u0647\u0627 iOS \u0644\u0644\u0645\u0637\u0648\u0631\u064a\u0646 \u0627\u0644\u0622\u062e\u0631\u064a\u0646. \u0648\u0634\u0631\u064a\u062d\u0629 MIFARE Classic 1K \u0647\u064a \u0627\u0644\u062a\u064a \u064a\u0635\u0627\u062f\u0641\u0647\u0627 \u0627\u0644\u0646\u0627\u0633."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "\u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0633\u062a\u064f\u0647\u0644\u0643\u062a. \u0645\u0644\u0635\u0642 NTAG213\u200f \u064a\u0646\u062c\u0648 \u0639\u0627\u062f\u0629\u064b \u0645\u0646 \u0646\u0632\u0639\u0647 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629\u060c \u0648\u0646\u0627\u062f\u0631\u064b\u0627 \u0645\u0631\u062a\u064a\u0646."
								}
							]
						}
					]
				}
			]
		},
