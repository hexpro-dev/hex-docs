		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u0628\u0639\u0636 \u0627\u0644\u0634\u0631\u0627\u0626\u062d \u062a\u0633\u062a\u062c\u064a\u0628 \u0644\u0623\u0648\u0644 \u0627\u0633\u062a\u0642\u0635\u0627\u0621 \u0628\u0639\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u062b\u0645 \u062a\u062a\u062c\u0627\u0647\u0644 \u0643\u0644 \u0627\u0633\u062a\u0642\u0635\u0627\u0621 \u0644\u0627\u062d\u0642 \u062d\u062a\u0649 \u062a\u0641\u0642\u062f \u0627\u0644\u0645\u062c\u0627\u0644 \u0646\u062d\u0648 \u0646\u0635\u0641 \u062b\u0627\u0646\u064a\u0629. \u0641\u0625\u0630\u0627 \u0642\u064f\u0631\u0626\u062a \u0628\u0637\u0627\u0642\u0629 \u0645\u0646 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u062b\u0645 \u0641\u0634\u0644\u062a \u0639\u062f\u0629 \u0645\u0631\u0627\u062a \u0645\u062a\u062a\u0627\u0644\u064a\u0629 \u0628\u0639\u062f\u0647\u0627\u060c \u0641\u0623\u0628\u0639\u062f \u0627\u0644\u0647\u0627\u062a\u0641 \u0639\u0646\u0647\u0627 \u062c\u064a\u062f\u064b\u0627\u060c \u0648\u0639\u064f\u062f\u0651 \u0625\u0644\u0649 \u0627\u062b\u0646\u064a\u0646\u060c \u062b\u0645 \u0627\u0645\u0633\u062d \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"id": "\u0644\u0645\u0627\u0630\u0627-\u064a\u062a\u0648\u0642\u0641-\u0627\u0644\u0645\u0633\u062d-\u0641\u064a-\u0645\u0646\u062a\u0635\u0641\u0647",
			"idSource": "slug",
			"children": [
				{
					"type": "text",
					"value": "\u0644\u0645\u0627\u0630\u0627 \u064a\u062a\u0648\u0642\u0641 \u0627\u0644\u0645\u0633\u062d \u0641\u064a \u0645\u0646\u062a\u0635\u0641\u0647\u061f"
				}
			],
			"aliases": [
				"why-does-the-scan-stop-halfway-through"
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u0639\u0628\u0627\u0631\u0629 \u00ab\u0627\u0646\u0642\u0637\u0639 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0628\u0637\u0627\u0642\u0629\u00bb \u062a\u0639\u0646\u064a \u0623\u0646 \u0648\u0635\u0644\u0629 \u0627\u0644\u0631\u0627\u062f\u064a\u0648 \u0627\u0646\u0642\u0637\u0639\u062a \u0623\u062b\u0646\u0627\u0621 \u0642\u0631\u0627\u0621\u0629 \u0623\u0648 \u0643\u062a\u0627\u0628\u0629 \u0644\u0645 \u062a\u0643\u062a\u0645\u0644 \u0628\u0639\u062f. \u0648\u0627\u0644\u0633\u0628\u0628 \u0639\u0627\u062f\u0629\u064b \u0623\u0646 \u0627\u0644\u0647\u0627\u062a\u0641 \u062a\u062d\u0631\u0643. \u064a\u064f\u0628\u0642\u064a \u200fFixture App \u0627\u0644\u062c\u0644\u0633\u0629 \u0645\u0641\u062a\u0648\u062d\u0629 20 \u062b\u0627\u0646\u064a\u0629\u060c \u0641\u0644\u0627 \u062f\u0627\u0639\u064a \u0644\u0644\u0639\u062c\u0644\u0629\u060c \u0644\u0643\u0646 \u0639\u0644\u0649 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0623\u0646 \u062a\u0628\u0642\u0649 \u0645\u0643\u0627\u0646\u0647\u0627 \u0627\u0644\u062b\u0627\u0646\u064a\u062a\u064a\u0646 \u0623\u0648 \u0627\u0644\u062b\u0644\u0627\u062b \u0627\u0644\u062a\u064a \u062a\u0633\u062a\u063a\u0631\u0642\u0647\u0627 \u0627\u0644\u0643\u062a\u0627\u0628\u0629."
				}
			]
		},
		{
			"type": "callout",
			"kind": "important",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "\u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0644\u064a\u0633\u062a \u0630\u0631\u0651\u064a\u0629. \u0641\u0625\u0630\u0627 \u0627\u0646\u0642\u0637\u0639\u062a \u0627\u0644\u0648\u0635\u0644\u0629 \u0641\u064a \u0645\u0646\u062a\u0635\u0641\u0647\u0627\u060c \u062a\u0628\u0642\u0649 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u062d\u0627\u0645\u0644\u0629 \u0646\u0635\u0641 \u0631\u0633\u0627\u0644\u0629 \u0648\u064a\u0628\u0644\u0651\u063a \u0627\u0644\u0645\u0633\u062d \u0627\u0644\u062a\u0627\u0644\u064a \u0639\u0646 \u00ab\u0631\u0633\u0627\u0644\u0629 \u062a\u0627\u0644\u0641\u0629\u00bb. \u0648\u0644\u0627 \u064a\u0636\u064a\u0639 \u0634\u064a\u0621 \u0625\u0644\u0649 \u0627\u0644\u0623\u0628\u062f: \u0627\u0643\u062a\u0628 \u0639\u0644\u0649 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0645\u062c\u062f\u062f\u064b\u0627 \u0645\u0646 \u0648\u0631\u0642\u0629 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0641\u064a\u064f\u0633\u062a\u0628\u062f\u0644 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0642\u062f\u064a\u0645."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"id": "\u0644\u0645\u0627\u0630\u0627-\u0623\u0633\u062a\u0637\u064a\u0639-\u0642\u0631\u0627\u0621\u0629-\u0628\u0637\u0627\u0642\u0629-\u062f\u0648\u0646-\u0627\u0644\u0643\u062a\u0627\u0628\u0629-\u0639\u0644\u064a\u0647\u0627",
			"idSource": "slug",
			"children": [
				{
					"type": "text",
					"value": "\u0644\u0645\u0627\u0630\u0627 \u0623\u0633\u062a\u0637\u064a\u0639 \u0642\u0631\u0627\u0621\u0629 \u0628\u0637\u0627\u0642\u0629 \u062f\u0648\u0646 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0639\u0644\u064a\u0647\u0627\u061f"
				}
			],
			"aliases": [
				"why-can-i-read-a-tag-but-not-write-to-it"
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u0642\u0641\u0644\u0627\u0646 \u0645\u062e\u062a\u0644\u0641\u0627\u0646 \u064a\u0624\u062f\u064a\u0627\u0646 \u0625\u0644\u0649 \u0627\u0644\u0646\u062a\u064a\u062c\u0629 \u0646\u0641\u0633\u0647\u0627. \u0627\u0644\u0623\u0648\u0644 \u0647\u0648 \u0627\u0644\u0630\u064a \u0627\u062e\u062a\u0631\u062a\u0647 \u0623\u0646\u062a\u060c \u0644\u0623\u0646 \u0648\u0631\u0642\u0629 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u062a\u0636\u0645 \u0645\u0641\u062a\u0627\u062d \u00ab\u0627\u0644\u0642\u0641\u0644 \u0628\u0639\u062f \u0627\u0644\u0643\u062a\u0627\u0628\u0629\u00bb\u060c \u0648\u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0642\u0641\u0644\u0629 \u0628\u0647\u0630\u0647 \u0627\u0644\u0637\u0631\u064a\u0642\u0629 \u062a\u064f\u0639\u0631\u0651\u0641 \u0646\u0641\u0633\u0647\u0627 \u0628\u0623\u0646\u0647\u0627 \u0644\u0644\u0642\u0631\u0627\u0621\u0629 \u0641\u0642\u0637 \u0645\u0646 \u062a\u0644\u0643 \u0627\u0644\u0644\u062d\u0638\u0629. \u0648\u0627\u0644\u062b\u0627\u0646\u064a \u064a\u062e\u0635 \u0627\u0644\u0634\u0631\u0643\u0629 \u0627\u0644\u0645\u0635\u0646\u0651\u0639\u0629. \u0641\u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u064f\u0628\u0627\u0639 \u0645\u0628\u0631\u0645\u062c\u0629 \u0645\u0633\u0628\u0642\u064b\u0627 \u0644\u0625\u0637\u0644\u0627\u0642 \u0645\u0646\u062a\u062c \u062a\u0635\u0644 \u0645\u0642\u0641\u0644\u0629 \u0639\u0627\u062f\u0629\u064b."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u0643\u0627\u0646\u062a \u0634\u0627\u0634\u0629 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u062a\u0635\u0641 \u0627\u0644\u062d\u0627\u0644\u062a\u064a\u0646 \u0628\u0623\u0646\u0647\u0645\u0627 "
				},
				{
					"type": "strikethrough",
					"children": [
						{
							"type": "text",
							"value": "\u0644\u0644\u0642\u0631\u0627\u0621\u0629 \u0641\u0642\u0637"
						}
					]
				},
				{
					"type": "text",
					"value": "\u060c \u0648\u0647\u0648 \u0645\u0627 \u0641\u0647\u0645\u0647 \u0627\u0644\u0646\u0627\u0633 \u0639\u0644\u0649 \u0623\u0646\u0647 \u0625\u0639\u062f\u0627\u062f \u064a\u0645\u0643\u0646\u0647\u0645 \u0625\u064a\u0642\u0627\u0641\u0647. \u0648\u0645\u0646\u0630 \u0627\u0644\u0625\u0635\u062f\u0627\u0631 1.4 \u0635\u0627\u0631\u062a \u062a\u0641\u0631\u0651\u0642 \u0628\u064a\u0646 \u00ab\u0645\u0642\u0641\u0644\u0629 \u0628\u0648\u0627\u0633\u0637\u062a\u0643\u00bb \u0648\u00ab\u0645\u0642\u0641\u0644\u0629 \u0641\u064a \u0627\u0644\u0645\u0635\u0646\u0639\u00bb."
				}
			]
		},
		{
			"type": "callout",
			"kind": "caution",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0627\u0644\u0642\u0641\u0644. \u0628\u062a\u0627\u062a \u0627\u0644\u0642\u0641\u0644 \u0641\u064a \u0634\u0631\u064a\u062d\u0629 NTAG21x \u0623\u062d\u0627\u062f\u064a\u0629 \u0627\u0644\u0627\u062a\u062c\u0627\u0647\u060c \u0648\u0628\u0645\u062c\u0631\u062f \u0636\u0628\u0637\u0647\u0627 \u0644\u0627 \u064a\u0633\u062a\u0637\u064a\u0639 \u0623\u064a \u0642\u0627\u0631\u0626 \u0639\u0644\u0649 \u0623\u064a \u0645\u0646\u0635\u0629 \u0645\u0633\u062d\u0647\u0627. \u0631\u0627\u062c\u0639 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0639\u0644\u0649 \u0634\u0627\u0634\u0629 \u0627\u0644\u0645\u0639\u0627\u064a\u0646\u0629 \u0642\u0628\u0644 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u0641\u062a\u0627\u062d."
						}
					]
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"id": "\u0644\u0645\u0627\u0630\u0627-\u064a\u0642\u0648\u0644-\u0627\u0644\u062a\u0637\u0628\u064a\u0642-\u0646\u0648\u0639-\u0627\u0644\u0628\u0637\u0627\u0642\u0629-\u063a\u064a\u0631-\u0645\u062f\u0639\u0648\u0645",
			"idSource": "slug",
			"children": [
				{
					"type": "text",
					"value": "\u0644\u0645\u0627\u0630\u0627 \u064a\u0642\u0648\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u00ab\u0646\u0648\u0639 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u063a\u064a\u0631 \u0645\u062f\u0639\u0648\u0645\u00bb\u061f"
				}
			],
			"aliases": [
				"why-does-the-app-say-unsupported-tag-type"
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u062a\u0639\u0646\u064a \u062a\u0644\u0643 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0623\u0646 iOS \u0633\u0644\u0651\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u0637\u0627\u0642\u0629 \u0644\u0627 \u064a\u062a\u0639\u0631\u0651\u0641 Fixture App \u0639\u0644\u0649 \u0634\u0631\u064a\u062d\u062a\u0647\u0627. \u062a\u062a\u0631\u0627\u062c\u0639 \u0627\u0644\u0642\u0631\u0627\u0621\u0629 \u0625\u0644\u0649 NDEF \u0627\u0644\u0645\u062c\u0631\u0651\u062f \u062d\u064a\u062b \u062a\u0633\u0645\u062d \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0628\u0630\u0644\u0643\u060c \u0648\u062a\u064f\u0631\u0641\u0636 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0628\u062f\u0644 \u0627\u0644\u0645\u062e\u0627\u0637\u0631\u0629 \u0628\u0634\u0631\u064a\u062d\u0629 \u0646\u0635\u0641 \u0645\u0647\u064a\u0651\u0623\u0629. \u0648\u064a\u0633\u0631\u062f "
				},
				{
					"type": "link",
					"kind": "internal",
					"slug": "reference/chip-support",
					"children": [
						{
							"type": "text",
							"value": "\u062c\u062f\u0648\u0644 \u062f\u0639\u0645 \u0627\u0644\u0634\u0631\u0627\u0626\u062d"
						}
					]
				},
				{
					"type": "text",
					"value": " \u0643\u0644 \u0634\u0631\u064a\u062d\u0629 \u0627\u062e\u062a\u064f\u0628\u0631 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0639\u0647\u0627 \u0648\u0645\u0627 \u0627\u0644\u0630\u064a \u064a\u0639\u0645\u0644 \u0639\u0644\u0649 \u0643\u0644 \u0645\u0646\u0647\u0627."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"id": "\u0645\u0627\u0630\u0627-\u0623\u0631\u0633\u0644-\u0639\u0646\u062f\u0645\u0627-\u0623\u0628\u0644-\u063a-\u0639\u0646-\u0645\u0634\u0643\u0644\u0629-\u0641\u064a-\u0627\u0644\u0645\u0633\u062d",
			"idSource": "slug",
			"children": [
				{
					"type": "text",
					"value": "\u0645\u0627\u0630\u0627 \u0623\u0631\u0633\u0644 \u0639\u0646\u062f\u0645\u0627 \u0623\u0628\u0644\u0651\u063a \u0639\u0646 \u0645\u0634\u0643\u0644\u0629 \u0641\u064a \u0627\u0644\u0645\u0633\u062d\u061f"
				}
			],
			"aliases": [
				"what-should-i-send-in-when-i-report-a-scan-problem"
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u0627\u0641\u062a\u062d \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\u060c \u062b\u0645 \u0627\u0644\u062a\u0634\u062e\u064a\u0635\u060c \u0648\u0627\u0636\u063a\u0637 \u00ab\u0646\u0633\u062e \u0633\u062c\u0644 \u0627\u0644\u0645\u0633\u062d\u00bb. \u064a\u063a\u0637\u064a \u0627\u0644\u0633\u062c\u0644 \u0622\u062e\u0631 \u0639\u0634\u0631\u064a\u0646 \u062c\u0644\u0633\u0629: \u0646\u0648\u0639 \u0627\u0644\u0634\u0631\u064a\u062d\u0629\u060c \u0648\u0639\u062f\u062f \u0627\u0644\u0628\u0627\u064a\u062a\u0627\u062a\u060c \u0648\u0627\u0644\u062e\u0637\u0623 \u0627\u0644\u0630\u064a \u0627\u0646\u062a\u0647\u062a \u0628\u0647 \u0643\u0644 \u062c\u0644\u0633\u0629. \u0648\u0647\u0648 \u0644\u0627 \u064a\u0633\u062c\u0644 \u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0648\u0644\u0627 \u0627\u0644\u0645\u0648\u0642\u0639."
				}
			]
		},
