				{
					"type": "text",
					"value": "\u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0639\u062f\u0651 \u0623\u0643\u062b\u0631 \u0645\u0646 \u062d\u0641\u0646\u0629 \u0628\u0637\u0627\u0642\u0627\u062a\u060c \u0641\u0623\u062c\u0631\u0650 \u062f\u0648\u0631\u0629 \u0643\u0627\u0645\u0644\u0629 \u0639\u0644\u0649 \u0628\u0637\u0627\u0642\u0629 \u0648\u0627\u062d\u062f\u0629 \u0642\u0628\u0644 \u0623\u0646 \u062a\u0644\u0645\u0633 \u0627\u0644\u0628\u0642\u064a\u0629. \u0627\u0643\u062a\u0628 \u0639\u0644\u064a\u0647\u0627\u060c \u062b\u0645 \u0627\u0642\u0631\u0623\u0647\u0627 \u0639\u0644\u0649 \u0647\u0627\u062a\u0641 \u062b\u0627\u0646\u064d\u060c \u062b\u0645 \u0627\u0642\u0641\u0644\u0647\u0627. \u0644\u0627 \u064a\u0645\u0643\u0646 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0639\u0644\u0649 \u0628\u0637\u0627\u0642\u0629 NTAG213\u200f \u0645\u0642\u0641\u0644\u0629\u060c \u0641\u062e\u0637\u0623 \u064a\u064f\u0643\u062a\u0634\u0641 \u0641\u064a \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u064a\u0643\u0644\u0651\u0641 \u0645\u0644\u0635\u0642\u064b\u0627\u060c \u0648\u062e\u0637\u0623 \u064a\u064f\u0643\u062a\u0634\u0641 \u0641\u064a \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0627\u0626\u062a\u064a\u0646 \u064a\u0643\u0644\u0651\u0641 \u0628\u0639\u062f \u0638\u0647\u0631 \u0643\u0627\u0645\u0644."
				}
