										{
											"type": "text",
											"value": "\u0627\u0645\u0633\u062d \u0628\u0637\u0627\u0642\u062a\u0643 \u0627\u0644\u0623\u0648\u0644\u0649"
										}
									]
								},
								{
									"type": "text",
									"value": " \u0648\u0631\u0642\u0629 \u0627\u0644\u0645\u0633\u062d\u060c \u0648\u0627\u0644\u0627\u0647\u062a\u0632\u0627\u0632 \u0627\u0644\u0630\u064a \u064a\u0646\u0637\u0644\u0642 \u0639\u0646\u062f \u0646\u062c\u0627\u062d \u0627\u0644\u0642\u0631\u0627\u0621\u0629\u060c \u0648\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0633\u062c\u0644\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0638\u0647\u0631 \u0628\u0639\u062f \u0641\u0643 \u062a\u0631\u0645\u064a\u0632 \u0627\u0644\u0628\u0637\u0627\u0642\u0629. \u0648\u0647\u064a \u062a\u0633\u062a\u062e\u062f\u0645 \u0645\u0644\u0635\u0642 NTAG213\u200f\u060c \u0648\u0647\u0648 \u0627\u0644\u0634\u0631\u064a\u062d\u0629 \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629 \u0641\u064a \u0645\u0639\u0638\u0645 \u0639\u0628\u0648\u0627\u062a \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0631\u062e\u064a\u0635\u0629."
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "\u062a\u0633\u0631\u062f \u0635\u0641\u062d\u0629 "
								},
								{
									"type": "link",
									"kind": "internal",
									"slug": "guide/troubleshooting",
									"children": [
										{
											"type": "text",
											"value": "\u0639\u0646\u062f\u0645\u0627 \u0644\u0627 \u064a\u0646\u062c\u062d \u0627\u0644\u0645\u0633\u062d"
										}
									]
								},
								{
									"type": "text",
									"value": " \u0627\u0644\u0623\u062e\u0637\u0627\u0621 \u0627\u0644\u062a\u064a \u0642\u062f \u064a\u0639\u064a\u062f\u0647\u0627 \u0631\u0627\u062f\u064a\u0648 NFC \u0648\u0645\u0639\u0646\u0649 \u0643\u0644 \u0648\u0627\u062d\u062f \u0645\u0646\u0647\u0627 \u0639\u0645\u0644\u064a\u064b\u0627. \u0648\u062a\u062a\u0646\u0627\u0648\u0644 \u0627\u0646\u062a\u0647\u0627\u0621 \u0645\u0647\u0644\u0629 \u0627\u0644\u062c\u0644\u0633\u0629\u060c \u0648\u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u064f\u0642\u0631\u0623 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u062b\u0645 \u0644\u0627 \u062a\u064f\u0642\u0631\u0623 \u0628\u0639\u062f\u0647\u0627 \u0623\u0628\u062f\u064b\u0627\u060c \u0648\u0645\u0634\u0643\u0644\u0629 \u0645\u0648\u0636\u0639 \u0627\u0644\u0647\u0648\u0627\u0626\u064a \u0627\u0644\u062a\u064a \u062a\u0641\u0633\u0651\u0631 \u0645\u0639\u0638\u0645 \u0627\u0644\u0628\u0644\u0627\u063a\u0627\u062a."
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u062a\u0641\u062a\u0631\u0636 \u0627\u0644\u0635\u0641\u062d\u062a\u0627\u0646 \u0623\u0646\u0643 \u0648\u0627\u0641\u0642\u062a \u0639\u0644\u0649 \u0637\u0644\u0628 \u0635\u0644\u0627\u062d\u064a\u0629 NFC \u0639\u0646\u062f \u0623\u0648\u0644 \u062a\u0634\u063a\u064a\u0644 \u0644\u0644\u062a\u0637\u0628\u064a\u0642. \u0648\u0625\u0630\u0627 \u0631\u0641\u0636\u062a\u0647\u060c \u064a\u0635\u0628\u062d \u0632\u0631 \u0627\u0644\u0645\u0633\u062d \u0645\u0639\u0637\u0651\u0644\u064b\u0627 \u0648\u064a\u0638\u0647\u0631 \u0634\u0631\u064a\u0637 \u0645\u0643\u062a\u0648\u0628 \u0639\u0644\u064a\u0647 \u00abNFC \u063a\u064a\u0631 \u0645\u062a\u0627\u062d\u00bb \u0641\u064a \u0623\u0639\u0644\u0649 \u0634\u0627\u0634\u0629 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a. \u0648\u062d\u0630\u0641 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u062b\u0645 \u0625\u0639\u0627\u062f\u0629 \u062a\u062b\u0628\u064a\u062a\u0647 \u0647\u0648 \u0627\u0644\u0633\u0628\u064a\u0644 \u0627\u0644\u0648\u062d\u064a\u062f \u0644\u0631\u0624\u064a\u0629 \u0630\u0644\u0643 \u0627\u0644\u0637\u0644\u0628 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."
				}
			]
		},
