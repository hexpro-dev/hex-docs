		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u0633\u0639\u0627\u062a \u0627\u0644\u0634\u0631\u0627\u0626\u062d \u0648\u062a\u062e\u0637\u064a\u0637\u0627\u062a \u0627\u0644\u0630\u0627\u0643\u0631\u0629 \u0648\u0623\u0646\u0648\u0627\u0639 \u0627\u0644\u0633\u062c\u0644\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u0642\u0628\u0644\u0647\u0627 \u0643\u0644 \u0634\u0631\u064a\u062d\u0629 \u0645\u0648\u062c\u0648\u062f\u0629 \u0641\u064a \u0642\u0633\u0645 \u0627\u0644\u0645\u0631\u062c\u0639 \u0644\u0627 \u0647\u0646\u0627. \u0648\u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u062e\u062a\u0627\u0631 \u0628\u0637\u0627\u0642\u0627\u062a \u0644\u0634\u0631\u0627\u0626\u0647\u0627\u060c \u0641\u0627\u0628\u062f\u0623 \u0628\u062c\u062f\u0648\u0644 \u062f\u0639\u0645 \u0627\u0644\u0634\u0631\u0627\u0626\u062d \u0628\u062f\u0644 \u0647\u0630\u0627 \u0627\u0644\u062f\u0644\u064a\u0644."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u0645\u062e\u0637\u0637 \u0639\u0646\u0627\u0648\u064a\u0646 Fixture App\u200f\u060c \u0648\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0627\u062e\u062a\u0635\u0627\u0631\u0627\u062a\u060c \u0648\u0631\u062f\u0648\u062f \u0646\u062f\u0627\u0621 \u062c\u0644\u0633\u0629 \u0627\u0644\u0628\u0637\u0627\u0642\u0629\u060c \u0643\u0644\u0647\u0627 \u0645\u0648\u0627\u062f \u0644\u0644\u0645\u0637\u0648\u0631\u064a\u0646. \u0648\u0644\u0627 \u062a\u062a\u0643\u0631\u0631 \u0641\u064a \u0627\u0644\u062f\u0644\u064a\u0644\u060c \u0644\u0623\u0646 \u0627\u0644\u062f\u0644\u064a\u0644 \u0645\u0643\u062a\u0648\u0628 \u0644\u0634\u062e\u0635 \u064a\u0645\u0633\u0643 \u0647\u0627\u062a\u0641\u064b\u0627 \u0648\u0645\u0644\u0635\u0642\u064b\u0627."
				}
			]
		},
		{
			"type": "blockquote",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "\u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u062a\u064a \u062a\u0641\u0634\u0644 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0639\u0644\u064a\u0647\u0627 \u0644\u064a\u0633\u062a \u0645\u0639\u0637\u0648\u0628\u0629 \u0641\u064a \u0627\u0644\u063a\u0627\u0644\u0628. \u062a\u062a\u0637\u0644\u0628 \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0628\u0642\u0627\u0621 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u062c\u0627\u0644 \u0637\u0648\u0627\u0644 \u0627\u0644\u0639\u0645\u0644\u064a\u0629\u060c \u0648\u0627\u0644\u064a\u062f \u0627\u0644\u062a\u064a \u062a\u0628\u062a\u0639\u062f \u0628\u0639\u062f \u0646\u063a\u0645\u0629 \u0627\u0644\u0642\u0631\u0627\u0621\u0629 \u062a\u064f\u062c\u0647\u0636 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0648\u062a\u062a\u0631\u0643 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0642\u0631\u0627\u0621\u0629 \u062f\u0648\u0646 \u062a\u063a\u064a\u064a\u0631. \u0623\u0628\u0642\u0650 \u064a\u062f\u0643 \u062b\u0627\u0628\u062a\u0629 \u062d\u062a\u0649 \u0627\u0644\u0646\u063a\u0645\u0629 \u0627\u0644\u062b\u0627\u0646\u064a\u0629."
						}
					]
				}
			]
		},
