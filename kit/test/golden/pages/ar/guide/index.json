		{
			"id": "\u062a\u0631\u062a\u064a\u0628-\u0627\u0644\u0642\u0631\u0627\u0621\u0629-\u0639\u0646\u062f-\u0646\u0634\u0631-\u062c\u062f\u064a\u062f",
			"depth": 2,
			"text": "\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0642\u0631\u0627\u0621\u0629 \u0639\u0646\u062f \u0646\u0634\u0631 \u062c\u062f\u064a\u062f"
		}
	],
	"body": [
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u064a\u063a\u0637\u064a \u0627\u0644\u062f\u0644\u064a\u0644 \u0623\u062c\u0632\u0627\u0621 Fixture App \u0627\u0644\u062a\u064a \u062a\u0633\u062a\u062e\u062f\u0645\u0647\u0627 \u0643\u0644 \u064a\u0648\u0645: \u0642\u0631\u0627\u0621\u0629 \u0628\u0637\u0627\u0642\u0629\u060c \u0648\u0643\u062a\u0627\u0628\u0629 \u062d\u0645\u0648\u0644\u0629 \u0639\u0644\u064a\u0647\u0627\u060c \u0648\u0645\u0639\u0631\u0641\u0629 \u0645\u0627 \u0627\u0644\u0630\u064a \u062d\u062f\u062b \u062d\u064a\u0646 \u064a\u0628\u0642\u0649 \u0627\u0644\u0647\u0627\u062a\u0641 \u0635\u0627\u0645\u062a\u064b\u0627. \u0648\u0647\u0648 \u064a\u0641\u062a\u0631\u0636 \u062c\u0647\u0627\u0632 iPhone \u064a\u062f\u0639\u0645 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0641\u064a \u0627\u0644\u062e\u0644\u0641\u064a\u0629\u060c \u0623\u064a \u0643\u0644 \u0637\u0631\u0627\u0632 \u0627\u0639\u062a\u0628\u0627\u0631\u064b\u0627 \u0645\u0646 iPhone XS\u200f \u0641\u0635\u0627\u0639\u062f\u064b\u0627."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u062a\u0646\u062f\u0631\u062c \u062a\u062d\u062a \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u0635\u0641\u062d\u062a\u0627\u0646. \u0627\u0642\u0631\u0623\u0647\u0645\u0627 \u0628\u0627\u0644\u062a\u0631\u062a\u064a\u0628 \u0641\u064a \u0627\u0644\u0645\u0631\u0629 \u0627\u0644\u0623\u0648\u0644\u0649."
				}
			]
		},
