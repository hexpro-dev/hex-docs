		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u062a\u0635\u0644 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0629 \u0625\u0644\u0649 \u0627\u0644\u0645\u0643\u062a\u0628\u0629\u060c \u0627\u0644\u0623\u062d\u062f\u062b \u0623\u0648\u0644\u064b\u0627\u060c \u0645\u0639 \u0646\u0648\u0639 \u0627\u0644\u0634\u0631\u064a\u062d\u0629 \u0648\u0648\u0642\u062a \u0627\u0644\u0642\u0631\u0627\u0621\u0629 \u062a\u062d\u062a \u0627\u0644\u0627\u0633\u0645. \u0648\u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 \u0625\u062d\u062f\u0627\u0647\u0627 \u064a\u0641\u062a\u062d \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0628\u0637\u0627\u0642\u0629\u060c \u062d\u064a\u062b \u062a\u0638\u0647\u0631 \u0627\u0644\u0628\u0627\u064a\u062a\u0627\u062a \u0627\u0644\u062e\u0627\u0645 \u0625\u0644\u0649 \u062c\u0627\u0646\u0628 \u0627\u0644\u0633\u062c\u0644\u0627\u062a \u0627\u0644\u0645\u0641\u0643\u0648\u0643 \u062a\u0631\u0645\u064a\u0632\u0647\u0627."
				}
			]
