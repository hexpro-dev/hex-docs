				{
					"type": "step",
					"id": "\u0627\u0641\u062a\u062d-\u0648\u0631\u0642\u0629-\u0627\u0644\u0645\u0633\u062d",
					"title": [
						{
							"type": "text",
							"value": "\u0627\u0641\u062a\u062d \u0648\u0631\u0642\u0629 \u0627\u0644\u0645\u0633\u062d"
						}
					],
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "\u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0627\u0644\u062f\u0627\u0626\u0631\u0629 \u0627\u0644\u0643\u0628\u064a\u0631\u0629 \u0641\u064a \u0648\u0633\u0637 \u0634\u0627\u0634\u0629 \u0627\u0644\u0645\u0643\u062a\u0628\u0629\u060c \u0623\u0648 \u0627\u0636\u063a\u0637 \u0645\u0637\u0648\u0651\u0644\u064b\u0627 \u0639\u0644\u0649 \u0623\u064a\u0642\u0648\u0646\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0641\u064a \u0627\u0644\u0634\u0627\u0634\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0648\u0627\u062e\u062a\u0631 \u00ab\u0645\u0633\u062d\u00bb. \u062a\u0646\u0632\u0644\u0642 \u0627\u0644\u0648\u0631\u0642\u0629 \u0625\u0644\u0649 \u0627\u0644\u0623\u0639\u0644\u0649 \u0648\u064a\u0638\u0647\u0631 \u0641\u064a \u0633\u0637\u0631 \u0627\u0644\u062d\u0627\u0644\u0629 \u00ab\u062c\u0627\u0647\u0632 \u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0628\u0637\u0627\u0642\u0629\u00bb."
								}
							]
						},
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "\u064a\u0628\u0642\u0649 \u0627\u0644\u0642\u0627\u0631\u0626 \u0645\u0633\u062a\u064a\u0642\u0638\u064b\u0627 60 \u062b\u0627\u0646\u064a\u0629. \u0648\u0625\u0630\u0627 \u0644\u0645 \u064a\u062f\u062e\u0644 \u0634\u064a\u0621 \u0641\u064a \u0627\u0644\u0645\u062f\u0649\u060c \u062a\u063a\u0644\u0642 \u0627\u0644\u0648\u0631\u0642\u0629 \u0646\u0641\u0633\u0647\u0627 \u0648\u0644\u0627 \u064a\u064f\u0636\u0627\u0641 \u0634\u064a\u0621 \u0625\u0644\u0649 \u0627\u0644\u0645\u0643\u062a\u0628\u0629."
								}
							]
						}
					]
				},
				{
					"type": "step",
					"id": "\u0636\u0639-\u0627\u0644\u0628\u0637\u0627\u0642\u0629-\u0639\u0644\u0649-\u0623\u0639\u0644\u0649-\u0627\u0644\u0647\u0627\u062a\u0641",
					"title": [
						{
							"type": "text",
							"value": "\u0636\u0639 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0639\u0644\u0649 \u0623\u0639\u0644\u0649 \u0627\u0644\u0647\u0627\u062a\u0641"
						}
					],
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "\u0623\u0633\u0646\u062f \u0627\u0644\u062d\u0627\u0641\u0629 \u0627\u0644\u0639\u0644\u0648\u064a\u0629 \u0645\u0646 \u0627\u0644\u0647\u0627\u062a\u0641 \u0628\u0634\u0643\u0644 \u0645\u0633\u062a\u0648\u064d \u0639\u0644\u0649 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0648\u0623\u0628\u0642\u0650 \u0627\u0644\u0627\u062b\u0646\u064a\u0646 \u062b\u0627\u0628\u062a\u064a\u0646. \u064a\u062a\u063a\u064a\u0631 \u0633\u0637\u0631 \u0627\u0644\u062d\u0627\u0644\u0629 \u0625\u0644\u0649 \u00ab\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0628\u0637\u0627\u0642\u0629\u00bb \u0648\u064a\u0635\u062f\u0631 \u0627\u0644\u0647\u0627\u062a\u0641 \u0646\u0642\u0631\u0629 \u0642\u0635\u064a\u0631\u0629."
								}
							]
						},
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "\u0627\u0644\u0645\u0648\u0636\u0639 \u0623\u0647\u0645 \u0645\u0646 \u0627\u0644\u0636\u063a\u0637:"
								}
							]
						},
