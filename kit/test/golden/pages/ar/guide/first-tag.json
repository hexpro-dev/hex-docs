					"type": "text",
					"value": "\u0625\u0639\u0627\u062f\u0629 \u062a\u0633\u0645\u064a\u0629 \u0628\u0637\u0627\u0642\u0629 \u062a\u063a\u064a\u0651\u0631 \u0645\u0627 \u062a\u0631\u0627\u0647 \u0641\u064a \u0627\u0644\u0645\u0643\u062a\u0628\u0629 \u0641\u0642\u0637. \u0648\u0644\u0627 \u064a\u064f\u0643\u062a\u0628 \u0623\u064a \u0634\u064a\u0621 \u0639\u0644\u0649 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0646\u0641\u0633\u0647\u0627 \u0645\u0627 \u0644\u0645 \u062a\u0633\u062a\u062e\u062f\u0645 \u0648\u0631\u0642\u0629 \u0627\u0644\u0643\u062a\u0627\u0628\u0629\u060c \u0648\u0647\u064a \u0625\u062c\u0631\u0627\u0621 \u0645\u0646\u0641\u0635\u0644."
