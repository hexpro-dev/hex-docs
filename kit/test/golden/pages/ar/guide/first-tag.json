	"body": [
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u062a\u0633\u062a\u063a\u0631\u0642 \u0627\u0644\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0646\u062d\u0648 \u0639\u0634\u0631 \u062b\u0648\u0627\u0646\u064d \u0628\u0639\u062f \u0623\u0646 \u062a\u0635\u0628\u062d \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0641\u064a \u064a\u062f\u0643. \u0648\u0645\u0639\u0638\u0645 \u0647\u0630\u0627 \u0627\u0644\u0648\u0642\u062a \u064a\u0630\u0647\u0628 \u0641\u064a \u062a\u062d\u062f\u064a\u062f \u0645\u0648\u0636\u0639 \u0627\u0644\u0647\u0648\u0627\u0626\u064a \u0639\u0644\u0649 \u0627\u0644\u0647\u0627\u062a\u0641\u060c \u0648\u0647\u0648 \u0623\u0639\u0644\u0649 \u0641\u064a \u0627\u0644\u0638\u0647\u0631 \u0645\u0645\u0627 \u064a\u062a\u0648\u0642\u0639 \u0627\u0644\u0646\u0627\u0633."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"id": "\u0642\u0628\u0644-\u0623\u0646-\u062a\u0628\u062f\u0623",
