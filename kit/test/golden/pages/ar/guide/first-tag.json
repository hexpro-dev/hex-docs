				"before-you-start"
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u064a\u0633\u062a\u062e\u062f\u0645 Fixture App \u0642\u0627\u0631\u0626 NFC \u0627\u0644\u0645\u0648\u062c\u0648\u062f \u0641\u064a \u0627\u0644\u0647\u0627\u062a\u0641\u060c \u0641\u0644\u064a\u0633 \u0647\u0646\u0627\u0643 \u0645\u0627 \u062a\u0642\u0631\u0646\u0647 \u0648\u0644\u0627 \u0645\u0627 \u062a\u0634\u062d\u0646\u0647. \u0648\u0623\u064a \u062c\u0647\u0627\u0632 iPhone \u0627\u0639\u062a\u0628\u0627\u0631\u064b\u0627 \u0645\u0646 iPhone 7\u200f \u0641\u0635\u0627\u0639\u062f\u064b\u0627\u060c \u064a\u0639\u0645\u0644 \u0628\u0646\u0638\u0627\u0645 \u200fiOS 16 \u0623\u0648 \u0623\u062d\u062f\u062b\u060c \u064a\u0633\u062a\u0637\u064a\u0639 \u0642\u0631\u0627\u0621\u0629 \u0628\u0637\u0627\u0642\u0629."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u062a\u062d\u062a\u0627\u062c \u0625\u0644\u0649 \u0628\u0637\u0627\u0642\u0629 \u064a\u0633\u062a\u0637\u064a\u0639 \u0627\u0644\u0642\u0627\u0631\u0626 \u0645\u062e\u0627\u0637\u0628\u062a\u0647\u0627\u060c \u0648\u0625\u0644\u0649 \u0645\u0633\u0627\u0631 \u062e\u0627\u0644\u064d \u0625\u0644\u064a\u0647\u0627:"
				}
			]
		},
		{
			"type": "list",
			"style": "bullet",
			"tight": true,
			"children": [
				{
					"type": "listItem",
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "\u062c\u0647\u0627\u0632 iPhone 7 \u0623\u0648 \u0623\u062d\u062f\u062b \u064a\u0639\u0645\u0644 \u0628\u0646\u0638\u0627\u0645 iOS 16 \u0623\u0648 \u0623\u062d\u062f\u062b"
								}
							]
						}
					],
					"checked": true
				},
				{
