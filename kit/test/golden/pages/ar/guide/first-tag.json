		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u064a\u0639\u064a\u062f \u0627\u0644\u0642\u0627\u0631\u0626 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0645\u0646 \u062a\u0644\u0642\u0627\u0621 \u0646\u0641\u0633\u0647. \u062a\u062c\u0631\u064a \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u062a\u0627\u0646 \u0627\u0644\u0623\u0648\u0644\u064a\u0627\u0646 \u0628\u0635\u0645\u062a\u060c \u0628\u0641\u0627\u0631\u0642 \u062b\u0627\u0646\u064a\u0629 \u062a\u0642\u0631\u064a\u0628\u064b\u0627 \u0628\u064a\u0646\u0647\u0645\u0627. \u0648\u0645\u0646 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u062b\u0627\u0644\u062b\u0629 \u062a\u0628\u062f\u0623 \u0627\u0644\u0648\u0631\u0642\u0629 \u0628\u0627\u0644\u0625\u0628\u0644\u0627\u063a \u0639\u0645\u0627 \u062a\u0641\u0639\u0644\u0647:"
				}
			]
		},
		{
