							"children": [
								{
									"type": "text",
									"value": "\u0639\u0646\u062f \u0627\u0646\u062a\u0647\u0627\u0621 \u0627\u0644\u0642\u0631\u0627\u0621\u0629 \u062a\u0633\u0631\u062f \u0627\u0644\u0648\u0631\u0642\u0629 \u0643\u0644 \u0633\u062c\u0644 NDEF \u0639\u0644\u0649 \u0627\u0644\u0628\u0637\u0627\u0642\u0629\u060c \u0628\u0627\u0644\u062a\u0631\u062a\u064a\u0628 \u0627\u0644\u0630\u064a \u062e\u064f\u0632\u0651\u0646\u062a \u0628\u0647. \u0648\u064a\u062a\u0639\u0631\u0651\u0641 Fixture App \u0639\u0644\u0649 \u0633\u062c\u0644\u0627\u062a URL \u0648\u0627\u0644\u0646\u0635\u0648\u0635 \u0648\u0633\u062c\u0644\u0627\u062a Wi-Fi \u0648\u064a\u0639\u0631\u0636 \u0645\u0639\u0627\u064a\u0646\u0629 \u0644\u0643\u0644 \u0645\u0646\u0647\u0627. \u0648\u0645\u0627 \u0639\u062f\u0627 \u0630\u0644\u0643 \u064a\u064f\u0633\u0631\u062f \u0643\u0628\u0627\u064a\u062a\u0627\u062a \u062e\u0627\u0645."
								}
							]
						},
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "\u0627\u0636\u063a\u0637 \u00ab\u062d\u0641\u0638\u00bb \u0644\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0627\u0644\u0628\u0637\u0627\u0642\u0629\u060c \u0623\u0648 \u00ab\u062a\u062c\u0627\u0647\u0644\u00bb \u0644\u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0648\u0631\u0642\u0629 \u062f\u0648\u0646 \u0643\u062a\u0627\u0628\u0629 \u0623\u064a \u0634\u064a\u0621 \u0641\u064a \u0627\u0644\u0645\u0643\u062a\u0628\u0629."
