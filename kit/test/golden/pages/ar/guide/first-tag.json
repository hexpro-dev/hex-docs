												{
													"type": "text",
													"value": "\u064a\u0645\u062a\u062f \u0627\u0644\u0647\u0648\u0627\u0626\u064a \u0639\u0644\u0649 \u0637\u0648\u0644 \u0627\u0644\u062d\u0627\u0641\u0629 \u0627\u0644\u0639\u0644\u0648\u064a\u0629\u060c \u0639\u0644\u0649 \u0628\u0639\u062f \u0633\u0646\u062a\u064a\u0645\u062a\u0631 \u062a\u0642\u0631\u064a\u0628\u064b\u0627 \u062a\u062d\u062a \u0634\u0631\u064a\u0637 \u0627\u0644\u0643\u0627\u0645\u064a\u0631\u0627."
