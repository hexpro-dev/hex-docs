					"children": [
						{
							"type": "text",
							"value": "\u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062d\u062a\u0648\u064a \u0645\u0646\u0637\u0642\u0629 \u0645\u062d\u0645\u064a\u0629 \u0628\u0643\u0644\u0645\u0629 \u0645\u0631\u0648\u0631 \u062a\u0633\u062a\u062c\u064a\u0628 \u0644\u0644\u062c\u0632\u0621 \u0627\u0644\u0623\u0648\u0644 \u0645\u0646 \u0627\u0644\u0642\u0631\u0627\u0621\u0629 \u0648\u062a\u0631\u0641\u0636 \u0627\u0644\u0628\u0627\u0642\u064a. \u064a\u0639\u0631\u0636 Fixture App \u0645\u0627 \u062d\u0635\u0644 \u0639\u0644\u064a\u0647 \u0648\u064a\u0636\u0639 \u0639\u0628\u0627\u0631\u0629 \u00ab\u0627\u0644\u0633\u062c\u0644\u0627\u062a \u063a\u064a\u0631 \u0645\u0643\u062a\u0645\u0644\u0629\u00bb \u062a\u062d\u062a \u0627\u0633\u0645 \u0627\u0644\u0628\u0637\u0627\u0642\u0629. \u0627\u0628\u062d\u062b \u0639\u0646 \u0647\u0630\u0627 \u0627\u0644\u0633\u0637\u0631 \u0642\u0628\u0644 \u0623\u0646 \u062a\u062b\u0642 \u0628\u0642\u0631\u0627\u0621\u0629 \u0628\u0637\u0627\u0642\u0629 \u062a\u062d\u0643\u0645 \u0628\u0627\u0644\u062f\u062e\u0648\u0644."
						}
