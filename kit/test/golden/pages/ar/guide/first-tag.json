					"value": "\u0627\u0644\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u062c\u0632\u0626\u064a\u0629 \u062a\u0628\u062f\u0648 \u0643\u0623\u0646\u0647\u0627 \u0646\u062c\u0627\u062d"
