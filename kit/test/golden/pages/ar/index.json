									"value": " \u0648"
								},
								{
									"type": "inlineCode",
									"value": "mailto:"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "\u0633\u062c\u0644\u0627\u062a \u062a\u0633\u0644\u064a\u0645 Wi-Fi \u0627\u0644\u062a\u064a \u064a\u0643\u062a\u0628\u0647\u0627 \u0647\u0627\u062a\u0641 Android"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "\u062d\u0645\u0648\u0644\u0627\u062a vCard\u060c \u0648\u062a\u064f\u0639\u0631\u0636 \u0639\u0644\u0649 \u0647\u064a\u0626\u0629 \u0628\u0637\u0627\u0642\u0629 \u062c\u0647\u0629 \u0627\u062a\u0635\u0627\u0644"
								}
							]
						}
					]
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u0627\u0644\u0643\u062a\u0627\u0628\u0629 "
				},
				{
					"type": "emphasis",
					"children": [
						{
							"type": "text",
							"value": "\u0645\u062a\u0644\u0650\u0641\u0629"
						}
					]
				},
				{
					"type": "text",
					"value": ". \u064a\u0633\u062a\u0628\u062f\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0631\u0633\u0627\u0644\u0629 NDEF \u0643\u0627\u0645\u0644\u0629 \u0628\u062f\u0644 \u0623\u0646 \u064a\u0636\u064a\u0641 \u0625\u0644\u064a\u0647\u0627\u060c \u0641\u0643\u0644 \u0645\u0627 \u0643\u0627\u0646 \u0639\u0644\u0649 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u064a\u062e\u062a\u0641\u064a \u0644\u062d\u0638\u0629 \u0627\u0644\u0636\u063a\u0637 \u0639\u0644\u0649 "
				},
				{
					"type": "strong",
					"children": [
						{
							"type": "text",
							"value": "\u0643\u062a\u0627\u0628\u0629"
						}
					]
				},
				{
					"type": "text",
					"value": ". \u062a\u0628\u0642\u0649 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u0645\u0642\u0641\u0644\u0629 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0642\u0631\u0627\u0621\u0629\u060c \u0648\u064a\u062a\u0648\u0642\u0641 \u0627\u0644\u0643\u0627\u062a\u0628 \u0628\u0631\u0633\u0627\u0644\u0629 \u200f"
				},
				{
					"type": "inlineCode",
					"value": "Tag is permanently locked"
				},
				{
					"type": "text",
					"value": " \u0628\u062f\u0644 \u0627\u0644\u0625\u0628\u0644\u0627\u063a \u0639\u0646 \u0646\u062c\u0627\u062d \u0627\u0644\u0639\u0645\u0644\u064a\u0629."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"id": "\u0645\u0627-\u062a\u062d\u062a\u0627\u062c-\u0625\u0644\u064a\u0647",
			"idSource": "slug",
			"children": [
				{
					"type": "text",
					"value": "\u0645\u0627 \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u064a\u0647"
				}
			],
			"aliases": [
				"what-you-need"
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u0627\u0644\u0639\u062a\u0627\u062f \u0627\u0644\u0645\u062f\u0639\u0648\u0645: iPhone 7 \u0623\u0648 \u0623\u062d\u062f\u062b\u060c \u064a\u0639\u0645\u0644 \u0628\u0646\u0638\u0627\u0645 iOS 16 \u0623\u0648 \u0623\u062d\u062f\u062b."
				},
				{
					"type": "break"
				},
				{
					"type": "text",
					"value": "\u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0645\u062f\u0639\u0648\u0645\u0629: \u0634\u0631\u0627\u0626\u062d ISO 14443 \u0645\u0646 \u0627\u0644\u0646\u0648\u0639 A \u0645\u0647\u064a\u0651\u0623\u0629 \u0644\u0640 NDEF."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u064a\u0633\u0631\u062f "
				},
				{
					"type": "link",
					"kind": "internal",
					"slug": "reference/chip-support",
					"children": [
						{
							"type": "text",
							"value": "\u062c\u062f\u0648\u0644 \u062f\u0639\u0645 \u0627\u0644\u0634\u0631\u0627\u0626\u062d"
						}
					]
				},
				{
					"type": "text",
					"value": " \u0643\u0644 \u0634\u0631\u064a\u062d\u0629 \u0627\u062e\u062a\u064f\u0628\u0631 \u0627\u0644\u0642\u0627\u0631\u0626 \u0645\u0639\u0647\u0627\u060c \u0648\u0645\u0642\u062f\u0627\u0631 \u0627\u0644\u0630\u0627\u0643\u0631\u0629 \u0627\u0644\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0643\u062a\u0627\u0628\u0629 \u0641\u064a \u0643\u0644 \u0645\u0646\u0647\u0627. \u062a\u062a\u0633\u0639 \u0634\u0631\u064a\u062d\u0629 \u200fNTAG213\u200f \u0644\u0640 132 \u0628\u0627\u064a\u062a\u060c \u0623\u064a \u0631\u0627\u0628\u0637 \u0642\u0635\u064a\u0631 \u0648\u0644\u0627 \u0634\u064a\u0621 \u064a\u064f\u0630\u0643\u0631 \u0628\u0639\u062f\u0647."
				}
			]
		},
		{
			"type": "callout",
			"kind": "note",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "\u0644\u0627 \u064a\u0633\u0644\u0651\u0645 iOS \u0628\u0637\u0627\u0642\u0629 \u0625\u0644\u0649 \u062a\u0637\u0628\u064a\u0642 \u064a\u0639\u0645\u0644 \u0641\u064a \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0625\u0644\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u062a\u062d\u0645\u0644 \u0633\u062c\u0644 URL \u064a\u0637\u0627\u0628\u0642 \u0627\u0644\u0646\u0637\u0627\u0642 \u0627\u0644\u0645\u0631\u062a\u0628\u0637 \u0628\u0627\u0644\u062a\u0637\u0628\u064a\u0642. \u0648\u0645\u0627 \u0639\u062f\u0627 \u0630\u0644\u0643 \u064a\u062a\u0637\u0644\u0628 \u0641\u062a\u062d \u0648\u0631\u0642\u0629 \u0627\u0644\u0645\u0633\u062d \u0641\u064a \u0627\u0644\u0645\u0642\u062f\u0645\u0629."
						}
					]
				}
			],
			"title": [
				{
					"type": "text",
					"value": "\u0627\u0644\u0645\u0633\u062d \u0641\u064a \u0627\u0644\u062e\u0644\u0641\u064a\u0629"
				}
			]
		},
		{
			"type": "callout",
			"kind": "caution",
			"children": [
				{
					"type": "paragraph",
					"children": [
						{
							"type": "text",
							"value": "\u064a\u062d\u062a\u0627\u062c Fixture App \u0625\u0644\u0649 \u0646\u062d\u0648 \u062b\u0627\u0646\u064a\u062a\u064a\u0646 \u0645\u0646 \u0627\u0644\u062a\u0644\u0627\u0645\u0633 \u0644\u0625\u062a\u0645\u0627\u0645 \u0639\u0645\u0644\u064a\u0629 \u0643\u062a\u0627\u0628\u0629. \u0648\u0627\u0644\u0636\u063a\u0637 \u0628\u0642\u0648\u0629 \u0623\u0643\u0628\u0631 \u0644\u0627 \u064a\u0642\u0635\u0651\u0631 \u0647\u0630\u0647 \u0627\u0644\u0645\u062f\u0629\u060c \u0648\u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u062a\u064a \u062a\u0646\u062b\u0646\u064a \u0639\u0644\u0649 \u063a\u0637\u0627\u0621 \u0645\u0639\u062f\u0646\u064a \u0642\u062f \u064a\u0646\u0643\u0633\u0631 \u0627\u0644\u0647\u0648\u0627\u0626\u064a \u062f\u0627\u062e\u0644 \u062d\u0634\u0648\u062a\u0647\u0627."
						}
					]
				}
			],
			"title": [
				{
					"type": "text",
					"value": "\u0644\u0627 \u062a\u0636\u063a\u0637 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0628\u0627\u0644\u0642\u0648\u0629 \u0639\u0644\u0649 \u0627\u0644\u0647\u0627\u062a\u0641"
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u0623\u0628\u0642\u0650 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0645\u0633\u062a\u0648\u064a\u0629 \u0648\u062b\u0627\u0628\u062a\u0629 \u062d\u062a\u0649 \u064a\u0638\u0647\u0631 \u0641\u064a \u0648\u0631\u0642\u0629 \u0627\u0644\u0645\u0633\u062d \u0634\u0631\u064a\u0637 \u0627\u0644\u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0623\u062e\u0636\u0631. \u0648\u0625\u0630\u0627 \u0627\u0646\u0642\u0637\u0639\u062a \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u062a\u062d\u062a\u0641\u0638 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0628\u0645\u062d\u062a\u0648\u0627\u0647\u0627 \u0627\u0644\u0633\u0627\u0628\u0642\u060c \u0641\u0625\u0639\u0627\u062f\u0629 \u0645\u062d\u0627\u0648\u0644\u0629 \u0643\u062a\u0627\u0628\u0629 \u0641\u0627\u0634\u0644\u0629 \u0623\u0645\u0631 \u0622\u0645\u0646."
				}
			]
		},
