		{
			"id": "\u0645\u0627-\u062a\u062d\u062a\u0627\u062c-\u0625\u0644\u064a\u0647",
			"depth": 2,
			"text": "\u0645\u0627 \u062a\u062d\u062a\u0627\u062c \u0625\u0644\u064a\u0647"
		},
		{
			"id": "\u0625\u0644\u0649-\u0623\u064a\u0646-\u062a\u0630\u0647\u0628-\u0628\u0639\u062f-\u0630\u0644\u0643",
			"depth": 2,
			"text": "\u0625\u0644\u0649 \u0623\u064a\u0646 \u062a\u0630\u0647\u0628 \u0628\u0639\u062f \u0630\u0644\u0643"
		}
	],
	"body": [
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u064a\u062d\u0648\u0651\u0644 Fixture App \u062c\u0647\u0627\u0632 iPhone \u0625\u0644\u0649 \u0642\u0627\u0631\u0626 \u0628\u0637\u0627\u0642\u0627\u062a \u0648\u0643\u0627\u062a\u0628 \u0644\u0647\u0627. \u0648\u0647\u0648 \u064a\u0639\u0645\u0644 \u0639\u0644\u0649 \u0639\u062a\u0627\u062f NFC \u0627\u0644\u0630\u064a \u062a\u062a\u064a\u062d\u0647 Apple \u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0637\u0631\u0641 \u0627\u0644\u062b\u0627\u0644\u062b\u060c \u0645\u0627 \u064a\u0639\u0646\u064a \u0628\u0637\u0627\u0642\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u064a \u0643\u0644 \u0645\u0631\u0629 \u0645\u0639 \u0628\u0642\u0627\u0621 \u0648\u0631\u0642\u0629 \u0627\u0644\u0645\u0633\u062d \u0645\u0641\u062a\u0648\u062d\u0629."
				}
			]
		},
		{
			"type": "heading",
			"depth": 2,
			"id": "\u0645\u0627-\u0627\u0644\u0630\u064a-\u064a\u0641\u0639\u0644\u0647-fixture-app",
			"idSource": "slug",
			"children": [
				{
					"type": "text",
					"value": "\u0645\u0627 \u0627\u0644\u0630\u064a \u064a\u0641\u0639\u0644\u0647 Fixture App"
				}
			],
			"aliases": [
				"what-fixture-app-does"
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u0636\u0639 \u0627\u0644\u062d\u0627\u0641\u0629 \u0627\u0644\u0639\u0644\u0648\u064a\u0629 \u0645\u0646 \u0627\u0644\u0647\u0627\u062a\u0641 \u0639\u0644\u0649 \u0628\u0637\u0627\u0642\u0629\u060c \u0641\u064a\u0641\u0643\u0651 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u062a\u0631\u0645\u064a\u0632 \u0631\u0633\u0627\u0644\u0629 \u200fNDEF \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629 \u0639\u0644\u064a\u0647\u0627. \u0645\u0646 \u0647\u0646\u0627\u0643 \u064a\u0645\u0643\u0646\u0643 \u062a\u062d\u0631\u064a\u0631 \u0633\u062c\u0644 \u0641\u064a \u0645\u0643\u0627\u0646\u0647 \u0623\u0648 \u0627\u0633\u062a\u0628\u062f\u0627\u0644 \u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0628\u0631\u0633\u0627\u0644\u0629 \u062c\u062f\u064a\u062f\u0629. \u0644\u0627 \u064a\u064f\u0631\u0641\u0639 \u0623\u064a \u0634\u064a\u0621\u060c \u0648\u0644\u0627 \u064a\u0628\u0642\u0649 \u0623\u064a \u0633\u062c\u0644 \u0644\u0644\u0645\u0633\u062d \u0628\u0639\u062f \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u062a\u0637\u0628\u064a\u0642."
				}
			]
		},
		{
			"type": "paragraph",
			"children": [
				{
					"type": "text",
					"value": "\u064a\u0641\u0647\u0645 \u0627\u0644\u0642\u0627\u0631\u0626 \u0627\u0644\u062d\u0645\u0648\u0644\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629:"
				}
			]
		},
		{
			"type": "list",
			"style": "bullet",
			"tight": true,
			"children": [
				{
					"type": "listItem",
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "\u0633\u062c\u0644\u0627\u062a \u0646\u0635\u064a\u0629\u060c \u0645\u0639 \u0631\u0645\u0632 \u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u0630\u064a \u062a\u0639\u0644\u0646\u0647 \u0627\u0644\u0628\u0637\u0627\u0642\u0629"
								}
							]
						}
					]
				},
				{
					"type": "listItem",
					"children": [
						{
							"type": "paragraph",
							"children": [
								{
									"type": "text",
									"value": "\u0633\u062c\u0644\u0627\u062a URI\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u062e\u062a\u0635\u0627\u0631\u0627\u062a "
