{
	"$id": "docs-1.json",
	"title": "docs-1",
	"description": "A documented project's own configuration: docs/site/docs.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"docs": {
			"type": "number",
			"const": 1
		},
		"project": {
			"type": "string",
			"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
		},
		"productName": {
			"type": "string",
			"minLength": 1
		},
		"repo": {
			"type": "string",
			"pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
		},
		"defaultAudience": {
			"type": "string",
			"enum": [
				"user",
				"developer",
				"both"
			]
		},
		"headingIds": {
			"type": "string",
			"enum": [
				"slug",
				"section-number"
			]
		},
		"sections": {
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
					},
					"kind": {
						"type": "string",
						"enum": [
							"manual",
							"guide",
							"reference"
						]
					}
				},
				"required": [
					"id",
					"kind"
				],
				"additionalProperties": false
			}
		},
		"i18n": {
			"type": "object",
			"properties": {
				"locales": {
					"minItems": 1,
					"type": "array",
					"items": {
						"type": "string",
						"enum": [
							"en",
							"zh",
							"ar",
							"es",
							"ja",
							"fr",
							"pt-BR"
						]
					}
				},
				"sourceLocale": {
					"type": "string",
					"const": "en"
				},
				"parity": {
					"type": "string",
					"enum": [
						"graceful",
						"required"
					]
				}
			},
			"required": [
				"locales",
				"sourceLocale",
				"parity"
			],
			"additionalProperties": false
		},
		"budgets": {
			"type": "object",
			"properties": {
				"titleMax": {
					"type": "integer",
					"minimum": 10,
					"maximum": 9007199254740991
				},
				"descriptionMax": {
					"type": "integer",
					"minimum": 40,
					"maximum": 9007199254740991
				},
				"pageBytesMax": {
					"type": "integer",
					"minimum": 1024,
					"maximum": 9007199254740991
				},
				"codeFenceBytesMax": {
					"type": "integer",
					"minimum": 1024,
					"maximum": 9007199254740991
				},
				"tableRowsMax": {
					"type": "integer",
					"minimum": 1,
					"maximum": 9007199254740991
				},
				"nestingDepthMax": {
					"type": "integer",
					"minimum": 4,
					"maximum": 9007199254740991
				},
				"assetBytesMax": {
					"type": "integer",
					"minimum": 1024,
					"maximum": 9007199254740991
				},
				"bundleBytesMax": {
					"type": "integer",
					"minimum": 1024,
					"maximum": 9007199254740991
				}
			},
			"required": [
				"titleMax",
				"descriptionMax",
				"pageBytesMax",
				"codeFenceBytesMax",
				"tableRowsMax",
				"nestingDepthMax",
				"assetBytesMax",
				"bundleBytesMax"
			],
			"additionalProperties": false
		},
		"code": {
			"type": "object",
			"properties": {
				"languages": {
					"minItems": 1,
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"required": [
				"languages"
			],
			"additionalProperties": false
		},
		"toc": {
			"type": "object",
			"properties": {
				"enabled": {
					"type": "boolean"
				},
				"maxDepth": {
					"anyOf": [
						{
							"type": "number",
							"const": 2
						},
						{
							"type": "number",
							"const": 3
						},
						{
							"type": "number",
							"const": 4
						}
					]
				},
				"minHeadings": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				}
			},
			"required": [
				"enabled",
				"maxDepth",
				"minHeadings"
			],
			"additionalProperties": false
		},
		"lint": {
			"type": "object",
			"properties": {
				"extends": {
					"type": "string",
					"const": "house"
				},
				"maxDisables": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				},
				"rules": {
					"type": "object",
					"propertyNames": {
						"type": "string",
						"enum": [
							"no-h1-in-body",
							"heading-depth",
							"heading-order",
							"no-raw-html",
							"code-fence-language",
							"table-header-required",
							"page-size",
							"unsupported-syntax",
							"front-matter-invalid",
							"title-length",
							"description-length",
							"description-is-a-sentence",
							"link-resolves",
							"anchor-resolves",
							"snippet-resolves",
							"orphan-page",
							"nav-duplicate",
							"nav-depth",
							"slug-reserved",
							"translation-missing",
							"translation-stale",
							"translation-is-source-text",
							"heading-set-matches-source",
							"glossary-term-translated",
							"bidi-balance",
							"no-em-dash",
							"no-en-dash-prose",
							"no-decorative-unicode",
							"no-banned-phrase",
							"no-filler-verb-stack",
							"no-hedging-stack",
							"no-rhetorical-opener",
							"no-triad",
							"no-symmetric-pairs",
							"no-bolded-bullet-leadins",
							"australian-spelling",
							"no-competitor-name",
							"internal-leak",
							"alt-text-required",
							"asset-colour-space",
							"asset-size",
							"asset-svg-unsafe"
						]
					},
					"additionalProperties": {
						"anyOf": [
							{
								"type": "string",
								"enum": [
									"error",
									"warning",
									"info",
									"off"
								]
							},
							{
								"type": "object",
								"properties": {
									"severity": {
										"type": "string",
										"enum": [
											"error",
											"warning",
											"info"
										]
									},
									"locales": {
										"type": "array",
										"items": {
											"type": "string",
											"enum": [
												"en",
												"zh",
												"ar",
												"es",
												"ja",
												"fr",
												"pt-BR"
											]
										}
									}
								},
								"required": [
									"severity"
								],
								"additionalProperties": false
							}
						]
					}
				},
				"bannedPhrases": {
					"type": "array",
					"items": {
						"type": "object",
						"properties": {
							"phrase": {
								"type": "string",
								"minLength": 1
							},
							"replacement": {
								"anyOf": [
									{
										"type": "string",
										"minLength": 1
									},
									{
										"type": "null"
									}
								]
							},
							"why": {
								"type": "string",
								"minLength": 1
							}
						},
						"required": [
							"phrase",
							"replacement",
							"why"
						],
						"additionalProperties": false
					}
				},
				"technicalTerms": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"required": [
				"extends",
				"maxDisables"
			],
			"additionalProperties": false
		},
		"taxonomy": {
			"type": "object",
			"properties": {
				"tags": {
					"type": "array",
					"items": {
						"type": "string",
						"minLength": 1
					}
				}
			},
			"required": [
				"tags"
			],
			"additionalProperties": false
		},
		"glossary": {
			"type": "array",
			"items": {
				"oneOf": [
					{
						"type": "object",
						"properties": {
							"kind": {
								"type": "string",
								"const": "do-not-translate"
							},
							"term": {
								"type": "string",
								"minLength": 1
							},
							"note": {
								"type": "string"
							}
						},
						"required": [
							"kind",
							"term"
						],
						"additionalProperties": false
					},
					{
						"type": "object",
						"properties": {
							"kind": {
								"type": "string",
								"const": "translate"
							},
							"term": {
								"type": "string",
								"minLength": 1
							},
							"translations": {
								"type": "object",
								"propertyNames": {
									"type": "string",
									"enum": [
										"en",
										"zh",
										"ar",
										"es",
										"ja",
										"fr",
										"pt-BR"
									]
								},
								"additionalProperties": {
									"type": "string",
									"minLength": 1
								},
								"required": [
									"en",
									"zh",
									"ar",
									"es",
									"ja",
									"fr",
									"pt-BR"
								]
							},
							"note": {
								"type": "string"
							}
						},
						"required": [
							"kind",
							"term",
							"translations"
						],
						"additionalProperties": false
					}
				]
			}
		}
	},
	"required": [
		"docs",
		"project",
		"productName",
		"repo",
		"defaultAudience",
		"headingIds",
		"sections",
		"i18n",
		"budgets",
		"code",
		"toc",
		"lint"
	],
	"additionalProperties": false
}
