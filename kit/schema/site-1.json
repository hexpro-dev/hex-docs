{
	"$id": "site-1.json",
	"title": "site-1",
	"description": "A docs mount in a consuming website: <project>.docs.json",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"type": "object",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"site": {
			"type": "number",
			"const": 1
		},
		"project": {
			"type": "string",
			"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
		},
		"basePath": {
			"type": "string",
			"pattern": "^\\/[a-z0-9]+(?:[-][a-z0-9]+)*(?:\\/[a-z0-9]+(?:[-][a-z0-9]+)*)*$"
		},
		"themeClass": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9-]*$"
		},
		"navLabel": {
			"type": "object",
			"propertyNames": {
				"type": "string",
				"enum": [
					"en",
					"zh",
					"ar",
					"es",
					"ja",
					"fr",
					"pt-BR"
				]
			},
			"additionalProperties": {
				"type": "string",
				"minLength": 1,
				"maxLength": 40
			},
			"required": [
				"en",
				"zh",
				"ar",
				"es",
				"ja",
				"fr",
				"pt-BR"
			]
		},
		"versions": {
			"minItems": 1,
			"type": "array",
			"items": {
				"type": "object",
				"properties": {
					"label": {
						"type": "string",
						"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$"
					},
					"commit": {
						"type": "string",
						"pattern": "^[0-9a-f]{40}$"
					},
					"released": {
						"type": "string",
						"pattern": "^\\d{4}-\\d{2}-\\d{2}$"
					},
					"default": {
						"type": "boolean",
						"const": true
					},
					"digest": {
						"type": "string",
						"pattern": "^[0-9a-f]{64}$"
					}
				},
				"required": [
					"label",
					"commit",
					"released"
				],
				"additionalProperties": false
			}
		},
		"pages": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 260
			}
		},
		"hidden": {
			"type": "array",
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 260
			}
		}
	},
	"required": [
		"site",
		"project",
		"basePath",
		"navLabel",
		"versions",
		"pages"
	],
	"additionalProperties": false
}
