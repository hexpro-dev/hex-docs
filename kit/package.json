{
	"name": "@hex-pro/docs-kit",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "The hex-docs toolchain: the hexdocs CLI, the MCP server, the JSON Schemas and the bundle compiler. Installs its own node_modules on first run and is never imported by a website.",
	"license": "UNLICENSED",
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@10.33.0",
	"exports": {
		".": "./src/index.ts",
		"./contracts": "./src/contracts/index.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"schemas": "tsx src/contracts/emit-json-schemas.ts"
	},
	"dependencies": {
		"tsx": "^4.19.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@types/node": "^22.10.0",
		"@vitest/coverage-v8": "^5.0.0",
		"typescript": "^5.7.0",
		"vitest": "^5.0.0"
	}
}
